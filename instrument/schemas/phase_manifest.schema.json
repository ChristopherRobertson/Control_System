{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase_manifest.schema.json",
  "title": "Measurement campaign phase manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "phase_id",
    "phase_run_id",
    "status",
    "operator_ids",
    "start_utc",
    "end_utc",
    "configuration_id",
    "repository",
    "calibration_bundle_ids",
    "artifact_index",
    "deviations",
    "user_input_required",
    "promotion_performed"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "phase_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"},
    "phase_run_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["PLANNED", "IN_PROGRESS", "PASS", "FAIL", "BLOCKED", "BYPASSED"]
    },
    "operator_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "start_utc": {"type": "string", "format": "date-time"},
    "end_utc": {"type": ["string", "null"], "format": "date-time"},
    "configuration_id": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "branch", "dirty_files"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "dirty_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "device_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "component_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sample_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "calibration_bundle_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "artifact_index": {"type": "string", "minLength": 1},
    "acquisition_index": {"type": "string"},
    "conditions_table": {"type": "string"},
    "measurements_table": {"type": "string"},
    "exclusions_table": {"type": "string"},
    "calibration_links_table": {"type": "string"},
    "procedural_writeup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "artifact_id",
        "document_version",
        "preparation_mode",
        "author_ids",
        "reviewer_ids",
        "review_status",
        "review_utc"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^procedural_writeup(?:_revision_[A-Za-z0-9._-]+)?\\.md$"
        },
        "artifact_id": {"type": "string", "minLength": 1},
        "document_version": {"type": "string", "minLength": 1},
        "preparation_mode": {
          "enum": [
            "PROSPECTIVE_CONTEMPORANEOUS",
            "RETROSPECTIVE_EVIDENCE_RECONSTRUCTION"
          ]
        },
        "author_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reviewer_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "review_status": {
          "enum": ["DRAFT", "READY_FOR_REVIEW", "ACCEPTED", "REJECTED"]
        },
        "review_utc": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "criterion_versions": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "deviations": {"type": "array", "items": {"type": "string"}},
    "user_input_required": {"type": "array", "items": {"type": "string"}},
    "restoration_artifact_id": {"type": ["string", "null"]},
    "promotion_performed": {"type": "boolean"},
    "promotion_approval_reference": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "1.1.0"}},
        "required": ["schema_version"]
      },
      "then": {"required": ["procedural_writeup"]}
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.1.0"},
          "status": {"enum": ["PASS", "FAIL", "BYPASSED"]}
        },
        "required": ["schema_version", "status"]
      },
      "then": {
        "properties": {
          "procedural_writeup": {
            "properties": {
              "review_status": {"const": "ACCEPTED"},
              "reviewer_ids": {"minItems": 1},
              "review_utc": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  ]
}
