{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IR spectroscope run manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "config_hash",
    "config_path",
    "git_commit",
    "operator",
    "timestamp_utc",
    "device_ids",
    "t660_recipes",
    "mux_routes",
    "mircat_setpoint",
    "mircat_actual_wavelength",
    "hf2li_settings_snapshot",
    "picoscope_settings",
    "timing_offset_file",
    "raw_data_paths",
    "command_log_paths",
    "device_readback_paths",
    "error_state",
    "abort_state",
    "blocker_status"
  ],
  "properties": {
    "config_hash": {"type": "string", "minLength": 64, "maxLength": 64},
    "config_path": {"type": "string"},
    "git_commit": {"type": "string"},
    "operator": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string"},
    "device_ids": {"type": "object"},
    "t660_recipes": {"type": ["array", "object"]},
    "mux_routes": {"type": "object"},
    "mircat_setpoint": {},
    "mircat_actual_wavelength": {},
    "hf2li_settings_snapshot": {"type": "object"},
    "picoscope_settings": {"type": "object"},
    "timing_offset_file": {"type": ["string", "null"]},
    "raw_data_paths": {"type": "array", "items": {"type": "string"}},
    "command_log_paths": {"type": "array", "items": {"type": "string"}},
    "device_readback_paths": {"type": "array", "items": {"type": "string"}},
    "error_state": {"type": "object"},
    "abort_state": {"type": "object"},
    "blocker_status": {"type": "object"}
  }
}
