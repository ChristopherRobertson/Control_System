Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"conformerPopulationsFromAreas", "[", 
    RowBox[{
    "area1905_", ",", " ", "area1934_", ",", " ", "strength1905_", ",", " ", 
     "strength1934_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n1905", ",", " ", "n1934"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"n1905", " ", "=", " ", 
       RowBox[{"area1905", "/", "strength1905"}]}], ";", "\n", 
      RowBox[{"n1934", " ", "=", " ", 
       RowBox[{"area1934", "/", "strength1934"}]}], ";", "\n", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<f1905\>\"", " ", "->", " ", 
         RowBox[{"n1905", "/", 
          RowBox[{"(", 
           RowBox[{"n1905", " ", "+", " ", "n1934"}], ")"}]}]}], ",", " ", 
        RowBox[{"\"\<f1934\>\"", " ", "->", " ", 
         RowBox[{"n1934", "/", 
          RowBox[{"(", 
           RowBox[{"n1905", " ", "+", " ", "n1934"}], ")"}]}]}]}], "|>"}]}]}],
     "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hrpPopulationFit", "[", 
    RowBox[{"ftirSpectrum_", ",", " ", "halfWindow_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "x", ",", " ", "b0", ",", " ", "b1", ",", " ", "a1905", ",", " ", 
       "a1934", ",", " ", "c1905", ",", " ", "c1934", ",", " ", "s1905", ",", 
       " ", "s1934", ",", " ", "center1", ",", " ", "center2", ",", " ", 
       "subset", ",", " ", "amplitudeGuess", ",", " ", "model", ",", " ", 
       "fit", ",", " ", "pars", ",", " ", "area1905", ",", " ", "area1934", ",",
        " ", "population"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"center1", " ", "=", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"hrpParameters", ",", " ", "\"\<BandCenter1905_cm1\>\""}], 
        "]"}]}], ";", "\n", 
      RowBox[{"center2", " ", "=", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"hrpParameters", ",", " ", "\"\<BandCenter1934_cm1\>\""}], 
        "]"}]}], ";", "\n", 
      RowBox[{"subset", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{"ftirSpectrum", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"center1", " ", "-", " ", "halfWindow"}], " ", "<=", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "<=", " ", 
           RowBox[{"center2", " ", "+", " ", "halfWindow"}]}], " ", "&"}]}], 
        "]"}]}], ";", "\n", 
      RowBox[{"amplitudeGuess", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"subset", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], " ", "-", 
          " ", 
          RowBox[{"Min", "[", 
           RowBox[{"subset", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}], ")"}], "/",
         "2"}]}], ";", "\n", 
      RowBox[{"model", " ", "=", " ", 
       RowBox[{"b0", " ", "+", " ", 
        RowBox[{"b1", "*", 
         RowBox[{"(", 
          RowBox[{"x", " ", "-", " ", 
           RowBox[{"Mean", "[", 
            RowBox[{"{", 
             RowBox[{"center1", ",", " ", "center2"}], "}"}], "]"}]}], 
          ")"}]}], " ", "+", " ", 
        RowBox[{"a1905", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", " ", "-", " ", "c1905"}], ")"}], "^", "2"}]}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "*", 
             RowBox[{"s1905", "^", "2"}]}], ")"}]}], "]"}]}], " ", "+", " ", 
        RowBox[{"a1934", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", " ", "-", " ", "c1934"}], ")"}], "^", "2"}]}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "*", 
             RowBox[{"s1934", "^", "2"}]}], ")"}]}], "]"}]}]}]}], ";", "\n", 
      RowBox[{"fit", " ", "=", " ", 
       RowBox[{"NonlinearModelFit", "[", "\n", 
        RowBox[{"subset", ",", "\n", 
         RowBox[{"{", 
          RowBox[{"model", ",", " ", 
           RowBox[{
            RowBox[{"a1905", " ", ">", " ", "0"}], " ", "&&", " ", 
            RowBox[{"a1934", " ", ">", " ", "0"}], " ", "&&", " ", 
            RowBox[{"s1905", " ", ">", " ", "0"}], " ", "&&", " ", 
            RowBox[{"s1934", " ", ">", " ", "0"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"center1", " ", "-", " ", "halfWindow"}], " ", "<=", " ",
              "c1905", " ", "<=", " ", 
             RowBox[{"center1", " ", "+", " ", "halfWindow"}]}], " ", "&&", 
            " ", 
            RowBox[{
             RowBox[{"center2", " ", "-", " ", "halfWindow"}], " ", "<=", " ",
              "c1934", " ", "<=", " ", 
             RowBox[{"center2", " ", "+", " ", "halfWindow"}]}]}]}], "}"}], ",",
          "\n", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"b0", ",", " ", 
             RowBox[{"Min", "[", 
              RowBox[{"subset", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "}"}], 
           ",", " ", 
           RowBox[{"{", 
            RowBox[{"b1", ",", " ", "0."}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a1905", ",", " ", "amplitudeGuess"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a1934", ",", " ", "amplitudeGuess"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"c1905", ",", " ", "center1"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"c1934", ",", " ", "center2"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"s1905", ",", " ", 
             RowBox[{"halfWindow", "/", "4"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"s1934", ",", " ", 
             RowBox[{"halfWindow", "/", "4"}]}], "}"}]}], "}"}], ",", "\n", 
         "x"}], "\n", "]"}]}], ";", "\n", 
      RowBox[{"pars", " ", "=", " ", 
       RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}], ";", "\n", 
      RowBox[{"area1905", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a1905", " ", "/.", " ", "pars"}], ")"}], "*", 
        RowBox[{"Abs", "[", 
         RowBox[{"s1905", " ", "/.", " ", "pars"}], "]"}], "*", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", "*", "Pi"}], "]"}]}]}], ";", "\n", 
      RowBox[{"area1934", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a1934", " ", "/.", " ", "pars"}], ")"}], "*", 
        RowBox[{"Abs", "[", 
         RowBox[{"s1934", " ", "/.", " ", "pars"}], "]"}], "*", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", "*", "Pi"}], "]"}]}]}], ";", "\n", 
      RowBox[{"population", " ", "=", " ", 
       RowBox[{"conformerPopulationsFromAreas", "[", 
        RowBox[{"area1905", ",", " ", "area1934", ",", " ", 
         RowBox[{"pv", "[", 
          RowBox[{
          "hrpParameters", ",", 
           " ", "\"\<RelativeIntegratedStrength1905\>\""}], "]"}], ",", " ", 
         RowBox[{"pv", "[", 
          RowBox[{
          "hrpParameters", ",", 
           " ", "\"\<RelativeIntegratedStrength1934\>\""}], "]"}]}], "]"}]}], 
      ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<Fit\>\"", " ", "->", " ", "fit"}], ",", "\n", 
        RowBox[{
         RowBox[{"\"\<Center1905_cm1\>\"", " ", "->", " ", "c1905"}], " ", "/.",
          " ", "pars"}], ",", "\n", 
        RowBox[{
         RowBox[{"\"\<Center1934_cm1\>\"", " ", "->", " ", "c1934"}], " ", "/.",
          " ", "pars"}], ",", "\n", 
        RowBox[{"\"\<FWHM1905_cm1\>\"", " ", "->", " ", 
         RowBox[{"2", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "*", 
            RowBox[{"Log", "[", "2", "]"}]}], "]"}], "*", 
          RowBox[{"Abs", "[", 
           RowBox[{"s1905", " ", "/.", " ", "pars"}], "]"}]}]}], ",", "\n", 
        RowBox[{"\"\<FWHM1934_cm1\>\"", " ", "->", " ", 
         RowBox[{"2", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "*", 
            RowBox[{"Log", "[", "2", "]"}]}], "]"}], "*", 
          RowBox[{"Abs", "[", 
           RowBox[{"s1934", " ", "/.", " ", "pars"}], "]"}]}]}], ",", "\n", 
        RowBox[{"\"\<Area1905_absorbance_cm1\>\"", " ", "->", " ", 
         "area1905"}], ",", "\n", 
        RowBox[{"\"\<Area1934_absorbance_cm1\>\"", " ", "->", " ", 
         "area1934"}], ",", "\n", 
        RowBox[{"\"\<Population\>\"", " ", "->", " ", "population"}], ",", 
        "\n", 
        RowBox[{"\"\<ParameterTable\>\"", " ", "->", " ", 
         RowBox[{"fit", "[", "\"\<ParameterTable\>\"", "]"}]}]}], "\n", 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hrpSpectralValidation", " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ftir", ",", " ", "qcl", ",", " ", "predicted", ",", " ", 
       "populationFit"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"ftir", " ", "=", " ", 
       RowBox[{"importSpectrumCSV", "[", 
        RowBox[{"pv", "[", 
         RowBox[{"dataFiles", ",", " ", "\"\<HRPCO_FTIR\>\""}], "]"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"qcl", " ", "=", " ", 
       RowBox[{"importSpectrumCSV", "[", 
        RowBox[{"pv", "[", 
         RowBox[{"dataFiles", ",", " ", "\"\<HRPCO_QCL\>\""}], "]"}], "]"}]}],
       ";", "\n", 
      RowBox[{"predicted", " ", "=", " ", 
       RowBox[{"predictQCLFromFTIR", "[", 
        RowBox[{"ftir", ",", " ", 
         RowBox[{"qcl", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
         RowBox[{"pv", "[", 
          RowBox[{
          "spectralModelParameters", ",", 
           " ", "\"\<QCL_LinewidthFWHM_cm1\>\""}], "]"}]}], "]"}]}], ";", 
      "\n", 
      RowBox[{"populationFit", " ", "=", " ", 
       RowBox[{"hrpPopulationFit", "[", 
        RowBox[{"ftir", ",", " ", 
         RowBox[{"pv", "[", 
          RowBox[{
          "calibrationParameters", ",", 
           " ", "\"\<PeakWindowHalfWidth_cm1\>\""}], "]"}]}], "]"}]}], ";", 
      "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<PredictedSpectrum\>\"", " ", "->", " ", "predicted"}], ",",
         "\n", 
        RowBox[{"\"\<ResidualSpectrum\>\"", " ", "->", " ", 
         RowBox[{"spectralResiduals", "[", 
          RowBox[{"predicted", ",", " ", "qcl"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<Metrics\>\"", " ", "->", " ", 
         RowBox[{"spectralMetrics", "[", 
          RowBox[{"predicted", ",", " ", "qcl"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<ConformerPopulationFit\>\"", " ", "->", " ", 
         "populationFit"}], ",", "\n", 
        RowBox[{"\"\<OverlayPlot\>\"", " ", "->", " ", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"{", 
