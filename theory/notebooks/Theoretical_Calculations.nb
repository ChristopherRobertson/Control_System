Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gaussianKernelDiscrete", "[", 
    RowBox[{"dt_", ",", " ", "sigma_", ",", " ", 
     RowBox[{"cutoffSigma_", ":", " ", "5"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"halfWidth", ",", " ", "times", ",", " ", "weights"}], "}"}], ",",
      "\n", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"sigma", " ", "==", " ", "0"}], ",", " ", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "1.", "}"}], "]"}]}], "]"}], ";", "\n", 
      RowBox[{"halfWidth", " ", "=", " ", 
       RowBox[{"Ceiling", "[", 
        RowBox[{"cutoffSigma", "*", 
         RowBox[{"sigma", "/", "dt"}]}], "]"}]}], ";", "\n", 
      RowBox[{"times", " ", "=", " ", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "halfWidth"}], ",", " ", "halfWidth"}], "]"}], "*", 
        "dt"}]}], ";", "\n", 
      RowBox[{"weights", " ", "=", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"times", "^", "2"}]}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", 
           RowBox[{"sigma", "^", "2"}]}], ")"}]}], "]"}]}], ";", "\n", 
      RowBox[{"weights", "/", 
       RowBox[{"Total", "[", "weights", "]"}]}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rectangularKernelDiscrete", "[", 
    RowBox[{"dt_", ",", " ", "width_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "count", "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"width", " ", "<=", " ", "dt"}], ",", " ", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "1.", "}"}], "]"}]}], "]"}], ";", "\n", 
      RowBox[{"count", " ", "=", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"Round", "[", 
          RowBox[{"width", "/", "dt"}], "]"}]}], "]"}]}], ";", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", "count", "]"}], ",", " ", 
        RowBox[{"count", " ", "=", " ", 
         RowBox[{"count", " ", "+", " ", "1"}]}]}], "]"}], ";", "\n", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"1.", "/", "count"}], ",", " ", "count"}], "]"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"applyCenteredKernel", "[", 
    RowBox[{"data_List", ",", " ", "kernel_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"ListConvolve", "[", 
    RowBox[{"kernel", ",", " ", "data", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Ceiling", "[", 
        RowBox[{
         RowBox[{"Length", "[", "kernel", "]"}], "/", "2"}], "]"}], ",", " ", 
       RowBox[{"Ceiling", "[", 
        RowBox[{
         RowBox[{"Length", "[", "kernel", "]"}], "/", "2"}], "]"}]}], "}"}], ",",
      " ", "0."}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"applyFirstOrderFilter", "[", 
    RowBox[{"data_List", ",", " ", "dt_", ",", " ", "tau_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"FoldList", "[", "\n", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"previous", ",", " ", "input"}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "dt"}], "/", "tau"}], "]"}], "*", "previous"}], " ", "+",
         " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "dt"}], "/", "tau"}], "]"}]}], ")"}], "*", 
         "input"}]}]}], "]"}], ",", "\n", 
     RowBox[{"First", "[", "data", "]"}], ",", "\n", 
     RowBox[{"Rest", "[", "data", "]"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"instrumentBlur", "[", 
    RowBox[{
    "data_List", ",", " ", "dt_", ",", " ", "pumpFWHM_", ",", " ", 
     "probeWidth_", ",", " ", "jitterSigma_", ",", " ", "detectorTau_", ",", 
     " ", "lockinTau_", ",", " ", "lockinOrder_Integer"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", "\n", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pumpSigma", ",", " ", "opticalSigma", ",", " ", "result"}], 
      "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"pumpSigma", " ", "=", " ", 
       RowBox[{"pumpFWHM", "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "*", 
            RowBox[{"Log", "[", "2", "]"}]}], "]"}]}], ")"}]}]}], ";", "\n", 
      RowBox[{"opticalSigma", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"pumpSigma", "^", "2"}], " ", "+", " ", 
         RowBox[{"jitterSigma", "^", "2"}]}], "]"}]}], ";", "\n", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{"applyCenteredKernel", "[", 
        RowBox[{"data", ",", " ", 
         RowBox[{"gaussianKernelDiscrete", "[", 
          RowBox[{"dt", ",", " ", "opticalSigma"}], "]"}]}], "]"}]}], ";", 
      "\n", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{"applyCenteredKernel", "[", 
        RowBox[{"result", ",", " ", 
         RowBox[{"rectangularKernelDiscrete", "[", 
          RowBox[{"dt", ",", " ", "probeWidth"}], "]"}]}], "]"}]}], ";", "\n", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{"applyFirstOrderFilter", "[", 
        RowBox[{"result", ",", " ", "dt", ",", " ", "detectorTau"}], "]"}]}], 
      ";", "\n", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"result", " ", "=", " ", 
         RowBox[{"applyFirstOrderFilter", "[", 
          RowBox[{"result", ",", " ", "dt", ",", " ", "lockinTau"}], "]"}]}], 
        ",", " ", 
        RowBox[{"{", "lockinOrder", "}"}]}], "]"}], ";", "\n", "result"}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"probeGateAverage", "[", 
    RowBox[{"trueFunction_", ",", " ", "time_", ",", " ", "width_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"width", " ", "==", " ", "0"}], ",", " ", 
     RowBox[{"trueFunction", "[", "time", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"trueFunction", "[", "u", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"u", ",", " ", 
          RowBox[{"time", " ", "-", " ", 
           RowBox[{"width", "/", "2"}]}], ",", " ", 
          RowBox[{"time", " ", "+", " ", 
           RowBox[{"width", "/", "2"}]}]}], "}"}]}], "]"}], "/", "width"}]}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.9959884952364235`*^9},
 CellLabel->
  "In[137]:=",ExpressionUUID->"2abd3c52-9504-2042-a5ec-1f448cb561d8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"temporalResponseRun", "[", "trueFunction_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "dt", ",", " ", "times", ",", " ", "trueValues", ",", " ", 
       "measuredValues"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"dt", " ", "=", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"temporalParameters", ",", " ", "\"\<TimeStep_s\>\""}], 
        "]"}]}], ";", "\n", 
      RowBox[{"times", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"pv", "[", 
          RowBox[{"temporalParameters", ",", " ", "\"\<TimeStart_s\>\""}], 
          "]"}], ",", " ", 
         RowBox[{"pv", "[", 
          RowBox[{"temporalParameters", ",", " ", "\"\<TimeStop_s\>\""}], 
          "]"}], ",", " ", "dt"}], "]"}]}], ";", "\n", 
      RowBox[{"trueValues", " ", "=", " ", 
       RowBox[{"trueFunction", " ", "/@", " ", "times"}]}], ";", "\n", 
      RowBox[{"measuredValues", " ", "=", " ", 
       RowBox[{"instrumentBlur", "[", "\n", 
        RowBox[{"trueValues", ",", "\n", "dt", ",", "\n", 
         RowBox[{"pv", "[", 
          RowBox[{"temporalParameters", ",", " ", "\"\<PumpFWHM_s\>\""}], 
          "]"}], ",", "\n", 
         RowBox[{"pv", "[", 
          RowBox[{"temporalParameters", ",", " ", "\"\<ProbeWidth_s\>\""}], 
          "]"}], ",", "\n", 
         RowBox[{"pv", "[", 
          RowBox[{
          "temporalParameters", ",", " ", "\"\<TimingJitterSigma_s\>\""}], 
          "]"}], ",", "\n", 
         RowBox[{"pv", "[", 
          RowBox[{
          "temporalParameters", ",", " ", "\"\<DetectorTimeConstant_s\>\""}], 
          "]"}], ",", "\n", 
         RowBox[{"pv", "[", 
          RowBox[{
          "temporalParameters", ",", " ", "\"\<LockinTimeConstant_s\>\""}], 
          "]"}], ",", "\n", 
         RowBox[{"Round", "[", 
          RowBox[{"pv", "[", 
           RowBox[{"temporalParameters", ",", " ", "\"\<LockinOrder\>\""}], 
           "]"}], "]"}]}], "\n", "]"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<TrueTrace\>\"", " ", "->", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"times", ",", " ", "trueValues"}], "}"}], "]"}]}], ",", 
        "\n", 
        RowBox[{"\"\<PredictedMeasuredTrace\>\"", " ", "->", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"times", ",", " ", "measuredValues"}], "}"}], "]"}]}], ",",
         "\n", 
        RowBox[{"\"\<Plot\>\"", " ", "->", " ", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"times", ",", " ", "trueValues"}], "}"}], "]"}], ",", 
             " ", 
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"times", ",", " ", "measuredValues"}], "}"}], "]"}]}], 
            "}"}], ",", " ", 
           RowBox[{"PlotLegends", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<True\>\"", ",", " ", "\"\<Predicted measured\>\""}],
              "}"}]}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
           RowBox[{"FrameLabel", " ", "->", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Time (s)\>\"", ",", 
              " ", "\"\<Delta absorbance\>\""}], "}"}]}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]}]}], "\n", 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"traceFWHM", "[", "trace_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"maximum", ",", " ", "halfMaximum", ",", " ", "selectedTimes"}],
       "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"maximum", " ", "=", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"trace", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"halfMaximum", " ", "=", " ", 
       RowBox[{"maximum", "/", "2"}]}], ";", "\n", 
      RowBox[{"selectedTimes", " ", "=", " ", 
       RowBox[{"Cases", "[", 
        RowBox[{"trace", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"time_", ",", " ", "value_"}], "}"}], " ", "/;", " ", 
           RowBox[{"value", " ", ">=", " ", "halfMaximum"}]}], " ", ":>", " ",
           "time"}]}], "]"}]}], ";", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "selectedTimes", "]"}], " ", ">=", " ", "2"}],
         ",", " ", 
        RowBox[{
         RowBox[{"Max", "[", "selectedTimes", "]"}], " ", "-", " ", 
         RowBox[{"Min", "[", "selectedTimes", "]"}]}], ",", " ", 
        RowBox[{"Missing", "[", "\"\<InsufficientSampling\>\"", "]"}]}], 
       "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"instrumentResponseRun", "[", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "dt", ",", " ", "times", ",", " ", "impulse", ",", " ", "response", ",",
        " ", "zeroIndex"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"dt", " ", "=", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"temporalParameters", ",", " ", "\"\<TimeStep_s\>\""}], 
        "]"}]}], ";", "\n", 
      RowBox[{"times", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"pv", "[", 
          RowBox[{"temporalParameters", ",", " ", "\"\<TimeStart_s\>\""}], 
          "]"}], ",", " ", 
         RowBox[{"pv", "[", 
          RowBox[{"temporalParameters", ",", " ", "\"\<TimeStop_s\>\""}], 
          "]"}], ",", " ", "dt"}], "]"}]}], ";", "\n", 
      RowBox[{"zeroIndex", " ", "=", " ", 
       RowBox[{"First", "[", 
        RowBox[{"Ordering", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "times", "]"}], ",", " ", "1"}], "]"}], "]"}]}],
       ";", "\n", 
      RowBox[{"impulse", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", " ", 
         RowBox[{"Length", "[", "times", "]"}]}], "]"}]}], ";", "\n", 
      RowBox[{
       RowBox[{"impulse", "[", 
        RowBox[{"[", "zeroIndex", " ", "]"}], "]"}], " ", "=", " ", 
       RowBox[{"1", "/", "dt"}]}], ";", "\n", 
      RowBox[{"response", " ", "=", " ", 
       RowBox[{"instrumentBlur", "[", "\n", 
        RowBox[{"impulse", ",", "\n", "dt", ",", "\n", 
         RowBox[{"pv", "[", 
          RowBox[{"temporalParameters", ",", " ", "\"\<PumpFWHM_s\>\""}], 
          "]"}], ",", "\n", 
         RowBox[{"pv", "[", 
          RowBox[{"temporalParameters", ",", " ", "\"\<ProbeWidth_s\>\""}], 
          "]"}], ",", "\n", 
         RowBox[{"pv", "[", 
          RowBox[{
          "temporalParameters", ",", " ", "\"\<TimingJitterSigma_s\>\""}], 
          "]"}], ",", "\n", 
         RowBox[{"pv", "[", 
          RowBox[{
          "temporalParameters", ",", " ", "\"\<DetectorTimeConstant_s\>\""}], 
          "]"}], ",", "\n", 
         RowBox[{"pv", "[", 
          RowBox[{
          "temporalParameters", ",", " ", "\"\<LockinTimeConstant_s\>\""}], 
          "]"}], ",", "\n", 
         RowBox[{"Round", "[", 
          RowBox[{"pv", "[", 
           RowBox[{"temporalParameters", ",", " ", "\"\<LockinOrder\>\""}], 
           "]"}], "]"}]}], "\n", "]"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<InstrumentResponseTrace\>\"", " ", "->", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"times", ",", " ", "response"}], "}"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<InstrumentResponseFWHM_s\>\"", " ", "->", " ", 
         RowBox[{"traceFWHM", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"times", ",", " ", "response"}], "}"}], "]"}], "]"}]}], ",",
         "\n", 
        RowBox[{"\"\<Area\>\"", " ", "->", " ", 
         RowBox[{
          RowBox[{"Total", "[", "response", "]"}], "*", "dt"}]}], ",", "\n", 
        RowBox[{"\"\<Plot\>\"", " ", "->", " ", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"times", ",", " ", "response"}], "}"}], "]"}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
           RowBox[{"FrameLabel", " ", "->", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Time (s)\>\"", ",", 
              " ", "\"\<Normalized response (s^-1)\>\""}], "}"}]}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]}]}], "\n", 
       "|>"}]}]}], "\n", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.9959884952458057`*^9},
 CellLabel->
  "In[143]:=",ExpressionUUID->"8c0ac172-0ecd-c64b-94ce-ec5c45f15195"]
}, Open  ]],

Cell[CellGroupData[{

Cell["21. Dual-Detector Normalization", "Section",ExpressionUUID->"07828adc-bc60-8748-9dac-68f486c9b424"],

Cell["\<\
This section quantifies transmission and absorbance while accounting for \
fluctuations shared by the sample and reference detector channels. The \
implemented trace-based input is the time-resolved dual-channel voltage \
record labeled with background (0) and sample (1) state codes; from each \
state, the analysis obtains channel means, standard deviations, covariance, \
and Pearson correlation. Transmission is the sample/reference ratio in the \
sample state divided by the corresponding background ratio, and absorbance is \
\[Minus]log10(T). First-order variance propagation includes the within-state \
covariance and is evaluated with and without reference-channel normalization, \
yielding mean normalized absorbance, predicted normalized and unnormalized \
absorbance standard deviations, the normalization-improvement factor, and \
state-specific correlations. These quantities establish whether normalization \
suppresses common-mode intensity noise. The separate parameter table records \
precomputed means, standard deviations, and correlations, but the present \
code does not convert those correlations to covariance or automatically \
evaluate the trace-summary function from that table. The trace calculation is \
defined only when both state codes occur; nonzero divisor means and positive \
transmission are also required. Propagation assumes mutually independent \
sample- and background-state estimates and fluctuations small enough for \
linearization.\
\>", "Text",ExpressionUUID->"acfdd109-47f5-264a-89c6-487477b47528"],

Cell[BoxData[
 RowBox[{"T", " ", "==", " ", "(", 
  RowBox[{"VsSample", "/", "VrSample"}], ")", "/", "(", 
  RowBox[{"VsBackground", "/", "VrBackground"}], ")"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"f340cdb4-ba10-f641-921f-0aa7f37bae85"],

Cell[BoxData[
 RowBox[{"A", " ", "==", " ", "-", "Log", "[", 
  RowBox[{"10", ",", " ", "T"}], "]"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"076873d8-7951-cd4b-91dc-513ecd0674f6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"normalizedTransmission", "[", 
    RowBox[{
    "vsSample_", ",", " ", "vrSample_", ",", " ", "vsBackground_", ",", " ", 
     "vrBackground_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"vsSample", "/", "vrSample"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"vsBackground", "/", "vrBackground"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"normalizedAbsorbance", "[", 
    RowBox[{
    "vsSample_", ",", " ", "vrSample_", ",", " ", "vsBackground_", ",", " ", 
     "vrBackground_"}], "]"}], " ", ":=", " ", 
   RowBox[{"-", 
    RowBox[{"Log", "[", 
     RowBox[{"10", ",", " ", 
      RowBox[{"normalizedTransmission", "[", 
       RowBox[{
       "vsSample", ",", " ", "vrSample", ",", " ", "vsBackground", ",", " ", 
        "vrBackground"}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ratioLogVariance", "[", 
    RowBox[{
    "muSample_", ",", " ", "sigmaSample_", ",", " ", "muReference_", ",", " ",
      "sigmaReference_", ",", " ", "covariance_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"sigmaSample", "^", "2"}], "/", 
       RowBox[{"muSample", "^", "2"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"sigmaReference", "^", "2"}], "/", 
       RowBox[{"muReference", "^", "2"}]}], " ", "-", " ", 
      RowBox[{"2", "*", 
       RowBox[{"covariance", "/", 
        RowBox[{"(", 
         RowBox[{"muSample", "*", "muReference"}], ")"}]}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Log", "[", "10", "]"}], "^", "2"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"normalizedAbsorbanceSigma", "[", 
    RowBox[{
    "muVsS_", ",", " ", "sigmaVsS_", ",", " ", "muVrS_", ",", " ", 
     "sigmaVrS_", ",", " ", "covS_", ",", " ", "muVsB_", ",", " ", 
     "sigmaVsB_", ",", " ", "muVrB_", ",", " ", "sigmaVrB_", ",", " ", 
     "covB_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Sqrt", "[", "\n", 
    RowBox[{
     RowBox[{"ratioLogVariance", "[", 
      RowBox[{
      "muVsS", ",", " ", "sigmaVsS", ",", " ", "muVrS", ",", " ", "sigmaVrS", 
       ",", " ", "covS"}], "]"}], " ", "+", " ", 
     RowBox[{"ratioLogVariance", "[", 
      RowBox[{
      "muVsB", ",", " ", "sigmaVsB", ",", " ", "muVrB", ",", " ", "sigmaVrB", 
       ",", " ", "covB"}], "]"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"unnormalizedAbsorbanceSigma", "[", 
    RowBox[{
    "muVsS_", ",", " ", "sigmaVsS_", ",", " ", "muVsB_", ",", " ", 
     "sigmaVsB_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"sigmaVsS", "^", "2"}], "/", 
        RowBox[{"muVsS", "^", "2"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"sigmaVsB", "^", "2"}], "/", 
        RowBox[{"muVsB", "^", "2"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Log", "[", "10", "]"}], "^", "2"}], ")"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"normalizationImprovementFactor", "[", 
    RowBox[{"unnormalizedSigma_", ",", " ", "normalizedSigma_"}], "]"}], " ", 
   ":=", " ", 
   RowBox[{"unnormalizedSigma", "/", "normalizedSigma"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dualDetectorTraceStatistics", "[", "traceData_", "]"}], " ", ":=",
    " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "groups", ",", " ", "sampleRows", ",", " ", "backgroundRows", ",", " ", 
       "sampleCovariance", ",", " ", "backgroundCovariance", ",", " ", 
       "normalizedSigma", ",", " ", "unnormalizedSigma"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"groups", " ", "=", " ", 
       RowBox[{"GroupBy", "[", 
        RowBox[{"traceData", ",", " ", "Last"}], "]"}]}], ";", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"groups", ",", " ", "0."}], "]"}]}], " ", "||", " ", 
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"groups", ",", " ", "1."}], "]"}]}]}], ",", " ", 
        RowBox[{"Return", "[", 
         RowBox[{"Missing", "[", "\"\<StateCodes0And1Required\>\"", "]"}], 
         "]"}]}], "]"}], ";", "\n", 
      RowBox[{"backgroundRows", " ", "=", " ", 
       RowBox[{"groups", "[", "0.", "]"}]}], ";", "\n", 
      RowBox[{"sampleRows", " ", "=", " ", 
       RowBox[{"groups", "[", "1.", "]"}]}], ";", "\n", 
      RowBox[{"sampleCovariance", " ", "=", " ", 
       RowBox[{"Covariance", "[", 
        RowBox[{
         RowBox[{"sampleRows", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
         RowBox[{"sampleRows", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], "]"}]}], ";", "\n", 
      RowBox[{"backgroundCovariance", " ", "=", " ", 
       RowBox[{"Covariance", "[", 
        RowBox[{
         RowBox[{"backgroundRows", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
         RowBox[{"backgroundRows", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], "]"}]}], ";", "\n", 
      RowBox[{"normalizedSigma", " ", "=", " ", 
       RowBox[{"normalizedAbsorbanceSigma", "[", "\n", 
        RowBox[{
         RowBox[{"Mean", "[", 
          RowBox[{"sampleRows", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"StandardDeviation", "[", 
          RowBox[{"sampleRows", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", "\n", 
         RowBox[{"Mean", "[", 
          RowBox[{"sampleRows", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"StandardDeviation", "[", 
          RowBox[{"sampleRows", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "]"}], ",", " ", 
         "sampleCovariance", ",", "\n", 
         RowBox[{"Mean", "[", 
          RowBox[{"backgroundRows", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"StandardDeviation", "[", 
          RowBox[{"backgroundRows", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", "\n", 
         RowBox[{"Mean", "[", 
          RowBox[{"backgroundRows", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"StandardDeviation", "[", 
          RowBox[{"backgroundRows", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "]"}], ",", " ", 
         "backgroundCovariance"}], "\n", "]"}]}], ";", "\n", 
      RowBox[{"unnormalizedSigma", " ", "=", " ", 
       RowBox[{"unnormalizedAbsorbanceSigma", "[", "\n", 
        RowBox[{
         RowBox[{"Mean", "[", 
          RowBox[{"sampleRows", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"StandardDeviation", "[", 
          RowBox[{"sampleRows", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", "\n", 
         RowBox[{"Mean", "[", 
          RowBox[{"backgroundRows", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"StandardDeviation", "[", 
          RowBox[{"backgroundRows", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "\n", 
        "]"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<MeanNormalizedAbsorbance\>\"", " ", "->", " ", 
         RowBox[{"normalizedAbsorbance", "[", 
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{"sampleRows", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"Mean", "[", 
            RowBox[{"sampleRows", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"Mean", "[", 
            RowBox[{"backgroundRows", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"Mean", "[", 
            RowBox[{"backgroundRows", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "]"}]}], "]"}]}], 
        ",", "\n", 
        RowBox[{"\"\<PredictedNormalizedSigmaAbsorbance\>\"", " ", "->", " ", 
         "normalizedSigma"}], ",", "\n", 
        RowBox[{"\"\<PredictedUnnormalizedSigmaAbsorbance\>\"", " ", "->", 
         " ", "unnormalizedSigma"}], ",", "\n", 
        RowBox[{"\"\<NormalizationImprovementFactor\>\"", " ", "->", " ", 
         RowBox[{"normalizationImprovementFactor", "[", 
          RowBox[{"unnormalizedSigma", ",", " ", "normalizedSigma"}], "]"}]}],
         ",", "\n", 
        RowBox[{"\"\<SampleStateCorrelation\>\"", " ", "->", " ", 
         RowBox[{"Correlation", "[", 
          RowBox[{
           RowBox[{"sampleRows", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
           RowBox[{"sampleRows", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], "]"}]}], ",", 
        "\n", 
        RowBox[{"\"\<BackgroundCorrelation\>\"", " ", "->", " ", 
         RowBox[{"Correlation", "[", 
          RowBox[{
           RowBox[{"backgroundRows", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
           RowBox[{"backgroundRows", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], "]"}]}]}], "\n", 
       "|>"}]}]}], "\n", "]"}]}], ";"}]}], "Input",
