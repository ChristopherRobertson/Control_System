Cell[CellGroupData[{

Cell["3. Beer\[Dash]Lambert and Film Absorbance", "Section",ExpressionUUID->"e84c4cac-3f00-5d42-9033-6d92ea6f56e1"],

Cell["\<\
This section defines the absorbance and transmission relations used for \
solution samples and polymer films. The required inputs for a solution are \
the wavenumber-dependent molar absorptivity in L mol^-1 cm^-1, concentration \
in mol L^-1, and optical path length in cm; the corresponding film \
calculation requires the Napierian absorption coefficient in cm^-1 and film \
thickness in cm. Solution absorbance is calculated from the \
Beer\[Dash]Lambert product A(\[Nu]\:0303) = \[CurlyEpsilon](\[Nu]\:0303)cl, \
whereas film transmission is calculated as exp(\[Minus]\[Alpha]d) and \
converted to base-10 absorbance as \[Alpha]d/ln(10). Reciprocal functions \
convert base-10 absorbance to transmission through T = 10^\[Minus]A and \
transmission to absorbance through A = \[Minus]log10(T). These definitions \
provide a common representation for subsequent solution and film \
calculations. The explicit distinction between Napierian attenuation and \
base-10 absorbance is retained to avoid a factor-of-ln(10) error when \
measured spectra and absorption coefficients are combined.\
\>", "Text",ExpressionUUID->"11e3a99e-2b81-c54e-89ec-0d02acb21650"],

Cell[BoxData[
 RowBox[{"A", "[", "nu", "]", " ", "==", " ", "epsilon", "[", "nu", "]", "*", 
  "concentration", "*", "pathLength"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"a29cfb8e-6f76-1d46-8705-255b964f0485"],

Cell[BoxData[
 RowBox[{"Afilm", "[", "nu", "]", " ", "==", " ", "alpha", "[", "nu", "]", "*",
   "thickness", "/", "Log", "[", "10", "]"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"4f8a079a-6926-9f43-a969-52751a585aa9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"solutionAbsorbance", "[", 
    RowBox[{
    "epsilonLMolCm_", ",", " ", "concentrationM_", ",", " ", 
     "pathLengthCm_"}], "]"}], " ", ":=", " ", 
   RowBox[{"epsilonLMolCm", "*", "concentrationM", "*", "pathLengthCm"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"filmTransmission", "[", 
    RowBox[{"alphaCm1_", ",", " ", "thicknessCm_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "alphaCm1"}], "*", "thicknessCm"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"filmAbsorbance", "[", 
    RowBox[{"alphaCm1_", ",", " ", "thicknessCm_"}], "]"}], " ", ":=", " ", 
   RowBox[{"alphaCm1", "*", 
    RowBox[{"thicknessCm", "/", 
     RowBox[{"Log", "[", "10", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"transmissionFromAbsorbance", "[", "absorbance_", "]"}], " ", ":=",
    " ", 
   RowBox[{"10", "^", 
    RowBox[{"-", "absorbance"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"absorbanceFromTransmission", "[", "transmission_", "]"}], " ", ":=",
    " ", 
   RowBox[{"-", 
    RowBox[{"Log", "[", 
     RowBox[{"10", ",", " ", "transmission"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{3.9959884950008373`*^9},
 CellLabel->"In[23]:=",ExpressionUUID->"ab0f7ef1-90c3-a04d-87d9-e2cafb6b7781"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Spectral Forward Model", "Section",ExpressionUUID->"af3745b7-3c56-6543-a9ab-34addcdf66a9"],

Cell[TextData[{
 "This section establishes the spectral forward model used to predict the \
finite-linewidth QCL measurement from a higher-resolution FTIR absorbance \
spectrum. The required inputs are the FTIR spectrum, measured QCL absorbances \
and their independently determined wavenumber setpoints, and the Gaussian QCL \
linewidth expressed as full width at half maximum; scan start, stop, and step \
values provide an alternative definition of the setpoint grid, while FTIR \
resolution, apodization, and prior smoothing are retained as \
reference-spectrum metadata. When the installed MIRcat specification \
constrains the linewidth rather than an independent measurement supplying it, \
the instrument documentation is cited; the documented pulsed linewidth is an \
upper bound of <1 cm^-1 rather than an exact measured Gaussian FWHM.",
 StyleBox["1",
  FontVariations -> {"Superscript" -> True}],
 " The FTIR absorbance is converted to transmission, linearly interpolated, \
multiplied by a Gaussian line-shape function centered at each QCL setpoint, \
normalized over the available FTIR interval, numerically integrated, and \
converted back to base-10 absorbance. The resulting predicted spectrum is \
compared with the measured QCL spectrum through residuals, root-mean-square \
error, mean residual, maximum absolute residual, and Pearson correlation. \
This comparison determines whether the measured line shapes and amplitudes \
are consistent with the independently specified spectral response. \
Convolution is performed in transmission space so that the calculation does \
not rely on the weak-absorbance approximation, and residual comparisons are \
restricted to the overlapping predicted and measured wavenumber range."
}], "Text",
 CellChangeTimes->{
  3.9959884948582306`*^9},ExpressionUUID->"e9bbfed4-e725-6b42-a4a7-\
0fd1b0c0daec"],

Cell[BoxData[
 RowBox[{"Tpred", "[", "nu0", "]", " ", "==", " ", "Integrate", "[", 
  RowBox[{"L", "[", 
   RowBox[{"nu", " ", "-", " ", "nu0"}], "]", "*", "10", "^", "(", 
   RowBox[{"-", "Aref", "[", "nu", "]"}], ")", ",", " ", "{", 
   RowBox[{"nu", ",", " ", "-", "Infinity", ",", " ", "Infinity"}], "}"}], 
  "]"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"eb03f410-9886-5f43-bef9-1aefcb511f1a"],

Cell[BoxData[
 RowBox[{"Apred", "[", "nu0", "]", " ", "==", " ", "-", "Log", "[", 
  RowBox[{"10", ",", " ", "Tpred", "[", "nu0", "]"}], "]"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"1a0e22ee-0df9-6744-a07c-b03203cc9843"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gaussianLine", "[", 
    RowBox[{"x_", ",", " ", "center_", ",", " ", "fwhm_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "4"}], "*", 
     RowBox[{"Log", "[", "2", "]"}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", " ", "-", " ", "center"}], ")"}], "/", "fwhm"}], ")"}], 
      "^", "2"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qclGrid", "[", 
    RowBox[{"startCm1_", ",", " ", "stopCm1_", ",", " ", "stepCm1_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"If", "[", "\n", 
    RowBox[{
     RowBox[{"startCm1", " ", "<=", " ", "stopCm1"}], ",", "\n", 
     RowBox[{"Range", "[", 
      RowBox[{"startCm1", ",", " ", "stopCm1", ",", " ", 
       RowBox[{"Abs", "[", "stepCm1", "]"}]}], "]"}], ",", "\n", 
     RowBox[{"Range", "[", 
      RowBox[{"startCm1", ",", " ", "stopCm1", ",", " ", 
       RowBox[{"-", 
        RowBox[{"Abs", "[", "stepCm1", "]"}]}]}], "]"}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"predictQCLFromFTIR", "[", 
    RowBox[{
    "referenceSpectrum_", ",", " ", "qclSetpoints_", ",", " ", 
     "qclFWHMCm1_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "nu", ",", " ", "absorbance", ",", " ", "transmissionInterpolation", ",",
        " ", "xmin", ",", " ", "xmax", ",", " ", "numerator", ",", " ", 
       "denominator"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"nu", " ", "=", " ", 
       RowBox[{"referenceSpectrum", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"absorbance", " ", "=", " ", 
       RowBox[{"referenceSpectrum", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"xmin", " ", "=", " ", 
       RowBox[{"Min", "[", "nu", "]"}]}], ";", " ", 
      RowBox[{"xmax", " ", "=", " ", 
       RowBox[{"Max", "[", "nu", "]"}]}], ";", "\n", 
      RowBox[{"transmissionInterpolation", " ", "=", " ", 
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"nu", ",", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "absorbance"}]}]}], "}"}], "]"}], ",", " ", 
         RowBox[{"InterpolationOrder", " ", "->", " ", "1"}]}], "]"}]}], ";", 
      "\n", 
      RowBox[{"Table", "[", "\n", 
       RowBox[{
        RowBox[{
         RowBox[{"numerator", " ", "=", " ", 
          RowBox[{"NIntegrate", "[", "\n", 
           RowBox[{
            RowBox[{
             RowBox[{"gaussianLine", "[", 
              RowBox[{"x", ",", " ", "center", ",", " ", "qclFWHMCm1"}], 
              "]"}], "*", 
             RowBox[{"transmissionInterpolation", "[", "x", "]"}]}], ",", 
            "\n", 
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "xmin", ",", " ", "xmax"}], "}"}], ",", 
            " ", 
            RowBox[{"Method", " ", "->", " ", "\"\<LocalAdaptive\>\""}]}], 
           "\n", "]"}]}], ";", "\n", 
         RowBox[{"denominator", " ", "=", " ", 
          RowBox[{"NIntegrate", "[", "\n", 
           RowBox[{
            RowBox[{"gaussianLine", "[", 
             RowBox[{"x", ",", " ", "center", ",", " ", "qclFWHMCm1"}], "]"}],
             ",", "\n", 
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "xmin", ",", " ", "xmax"}], "}"}], ",", 
            " ", 
            RowBox[{"Method", " ", "->", " ", "\"\<LocalAdaptive\>\""}]}], 
           "\n", "]"}]}], ";", "\n", 
         RowBox[{"{", 
          RowBox[{"center", ",", " ", 
           RowBox[{"-", 
            RowBox[{"Log", "[", 
             RowBox[{"10", ",", " ", 
              RowBox[{"numerator", "/", "denominator"}]}], "]"}]}]}], "}"}]}],
         ",", "\n", 
        RowBox[{"{", 
         RowBox[{"center", ",", " ", "qclSetpoints"}], "}"}]}], "\n", 
       "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spectralResiduals", "[", 
    RowBox[{"predicted_", ",", " ", "measured_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "interp", "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"interp", " ", "=", " ", 
       RowBox[{"Interpolation", "[", 
        RowBox[{"predicted", ",", " ", 
         RowBox[{"InterpolationOrder", " ", "->", " ", "1"}]}], "]"}]}], ";", 
      "\n", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
             RowBox[{"interp", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], "}"}], " ", "&"}], 
         " ", "/@", " ", "measured"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Min", "[", 
           RowBox[{"predicted", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], " ", "<=", 
          " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "<=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"predicted", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}]}], " ", 
         "&"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spectralMetrics", "[", 
    RowBox[{"predicted_", ",", " ", "measured_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "residual", "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"residual", " ", "=", " ", 
       RowBox[{
        RowBox[{"spectralResiduals", "[", 
         RowBox[{"predicted", ",", " ", "measured"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<RMSE_absorbance\>\"", " ", "->", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Mean", "[", 
           RowBox[{"residual", "^", "2"}], "]"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<MeanResidual_absorbance\>\"", " ", "->", " ", 
         RowBox[{"Mean", "[", "residual", "]"}]}], ",", "\n", 
        RowBox[{"\"\<MaxAbsoluteResidual_absorbance\>\"", " ", "->", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", "residual", "]"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<PearsonCorrelation\>\"", " ", "->", " ", 
         RowBox[{"Correlation", "[", "\n", 
          RowBox[{
           RowBox[{
            RowBox[{"Interpolation", "[", 
             RowBox[{"predicted", ",", " ", 
              RowBox[{"InterpolationOrder", " ", "->", " ", "1"}]}], "]"}], 
            " ", "/@", " ", 
            RowBox[{"measured", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ",", "\n", 
           RowBox[{"measured", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "\n", "]"}]}]}], 
       "\n", "|>"}]}]}], "\n", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.995988495008812*^9},
 CellLabel->"In[28]:=",ExpressionUUID->"0e82fd13-b193-da43-af16-c7e5df5bbd9d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"spectralModelParameters", " ", "=", " ", 
   RowBox[{"<|", "\n", 
    RowBox[{
     RowBox[{"\"\<QCL_LinewidthFWHM_cm1\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<cm^-1\>\"", ",", 
        " ", "\"\<Gaussian QCL linewidth used in the forward model\>\"", ",", 
        " ", "\"\<Measured or MIRcat setting\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<QCL_ScanStart_cm1\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<cm^-1\>\"", ",", 
        " ", "\"\<First QCL setpoint\>\"", ",", " ", "\"\<Reader input\>\""}],
        "]"}]}], ",", "\n", 
     RowBox[{"\"\<QCL_ScanStop_cm1\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<cm^-1\>\"", ",", 
        " ", "\"\<Last QCL setpoint\>\"", ",", " ", "\"\<Reader input\>\""}], 
       "]"}]}], ",", "\n", 
     RowBox[{"\"\<QCL_Step_cm1\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<cm^-1\>\"", ",", 
        " ", "\"\<Magnitude of the QCL wavenumber step\>\"", ",", 
        " ", "\"\<Reader input\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<FTIR_ResolutionFWHM_cm1\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<cm^-1\>\"", ",", 
