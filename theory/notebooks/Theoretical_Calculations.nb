Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"multiConformerPopulationsFromAreas", "[", 
    RowBox[{"areas_", ",", " ", "integratedStrengths_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "corrected", "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"corrected", " ", "=", " ", 
       RowBox[{"areas", "/", "integratedStrengths"}]}], ";", "\n", 
      RowBox[{"corrected", "/", 
       RowBox[{"Total", "[", "corrected", "]"}]}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mbPopulationFit", "[", 
    RowBox[{"ftirSpectrum_", ",", " ", "halfWindow_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "x", ",", " ", "b0", ",", " ", "b1", ",", " ", "a0", ",", " ", "a1", ",",
        " ", "a3", ",", " ", "c0", ",", " ", "c1", ",", " ", "c3", ",", " ", 
       "s0", ",", " ", "s1", ",", " ", "s3", ",", " ", "centers", ",", " ", 
       "subset", ",", " ", "amplitudeGuess", ",", " ", "model", ",", " ", 
       "fit", ",", " ", "pars", ",", " ", "areas", ",", " ", "population"}], 
      "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"centers", " ", "=", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"mbParameters", ",", " ", "\"\<BandCenters_cm1\>\""}], 
        "]"}]}], ";", "\n", 
      RowBox[{"subset", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{"ftirSpectrum", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Min", "[", "centers", "]"}], " ", "-", " ", 
            "halfWindow"}], " ", "<=", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "<=", " ", 
           RowBox[{
            RowBox[{"Max", "[", "centers", "]"}], " ", "+", " ", 
            "halfWindow"}]}], " ", "&"}]}], "]"}]}], ";", "\n", 
      RowBox[{"amplitudeGuess", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"subset", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], " ", "-", 
          " ", 
          RowBox[{"Min", "[", 
           RowBox[{"subset", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}], ")"}], "/",
         "3"}]}], ";", "\n", 
      RowBox[{"model", " ", "=", " ", 
       RowBox[{"b0", " ", "+", " ", 
        RowBox[{"b1", "*", 
         RowBox[{"(", 
          RowBox[{"x", " ", "-", " ", 
           RowBox[{"Mean", "[", "centers", "]"}]}], ")"}]}], " ", "+", " ", 
        RowBox[{"a0", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", " ", "-", " ", "c0"}], ")"}], "^", "2"}]}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "*", 
             RowBox[{"s0", "^", "2"}]}], ")"}]}], "]"}]}], " ", "+", " ", 
        RowBox[{"a1", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", " ", "-", " ", "c1"}], ")"}], "^", "2"}]}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "*", 
             RowBox[{"s1", "^", "2"}]}], ")"}]}], "]"}]}], " ", "+", " ", 
        RowBox[{"a3", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", " ", "-", " ", "c3"}], ")"}], "^", "2"}]}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "*", 
             RowBox[{"s3", "^", "2"}]}], ")"}]}], "]"}]}]}]}], ";", "\n", 
      RowBox[{"fit", " ", "=", " ", 
       RowBox[{"NonlinearModelFit", "[", "\n", 
        RowBox[{"subset", ",", "\n", 
         RowBox[{"{", 
          RowBox[{"model", ",", " ", 
           RowBox[{
            RowBox[{"a0", " ", ">", " ", "0"}], " ", "&&", " ", 
            RowBox[{"a1", " ", ">", " ", "0"}], " ", "&&", " ", 
            RowBox[{"a3", " ", ">", " ", "0"}], " ", "&&", " ", 
            RowBox[{"s0", " ", ">", " ", "0"}], " ", "&&", " ", 
            RowBox[{"s1", " ", ">", " ", "0"}], " ", "&&", " ", 
            RowBox[{"s3", " ", ">", " ", "0"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"centers", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "halfWindow"}], 
             " ", "<=", " ", "c0", " ", "<=", " ", 
             RowBox[{
              RowBox[{"centers", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
              "halfWindow"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"centers", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", "halfWindow"}], 
             " ", "<=", " ", "c1", " ", "<=", " ", 
             RowBox[{
              RowBox[{"centers", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", "+", " ", 
              "halfWindow"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"centers", "[", 
               RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", "halfWindow"}], 
             " ", "<=", " ", "c3", " ", "<=", " ", 
             RowBox[{
              RowBox[{"centers", "[", 
               RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
              "halfWindow"}]}]}]}], "}"}], ",", "\n", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"b0", ",", " ", 
             RowBox[{"Min", "[", 
              RowBox[{"subset", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "}"}], 
           ",", " ", 
           RowBox[{"{", 
            RowBox[{"b1", ",", " ", "0."}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a0", ",", " ", "amplitudeGuess"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a1", ",", " ", "amplitudeGuess"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a3", ",", " ", "amplitudeGuess"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"c0", ",", " ", 
             RowBox[{"centers", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"c1", ",", " ", 
             RowBox[{"centers", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"c3", ",", " ", 
             RowBox[{"centers", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"s0", ",", " ", 
             RowBox[{"halfWindow", "/", "4"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"s1", ",", " ", 
             RowBox[{"halfWindow", "/", "4"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"s3", ",", " ", 
             RowBox[{"halfWindow", "/", "4"}]}], "}"}]}], "}"}], ",", "\n", 
         "x"}], "\n", "]"}]}], ";", "\n", 
      RowBox[{"pars", " ", "=", " ", 
       RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}], ";", "\n", 
      RowBox[{"areas", " ", "=", " ", 
       RowBox[{"{", "\n", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"a0", " ", "/.", " ", "pars"}], ")"}], "*", 
          RowBox[{"Abs", "[", 
           RowBox[{"s0", " ", "/.", " ", "pars"}], "]"}], "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "*", "Pi"}], "]"}]}], ",", "\n", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"a1", " ", "/.", " ", "pars"}], ")"}], "*", 
          RowBox[{"Abs", "[", 
           RowBox[{"s1", " ", "/.", " ", "pars"}], "]"}], "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "*", "Pi"}], "]"}]}], ",", "\n", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"a3", " ", "/.", " ", "pars"}], ")"}], "*", 
          RowBox[{"Abs", "[", 
           RowBox[{"s3", " ", "/.", " ", "pars"}], "]"}], "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "*", "Pi"}], "]"}]}]}], "\n", "}"}]}], ";", "\n", 
      RowBox[{"population", " ", "=", " ", 
       RowBox[{"multiConformerPopulationsFromAreas", "[", 
        RowBox[{"areas", ",", " ", 
         RowBox[{"pv", "[", 
          RowBox[{
          "mbParameters", ",", " ", "\"\<RelativeIntegratedStrengths\>\""}], 
          "]"}]}], "]"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<Fit\>\"", " ", "->", " ", "fit"}], ",", "\n", 
        RowBox[{"\"\<CentersA0A1A3_cm1\>\"", " ", "->", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"c0", ",", " ", "c1", ",", " ", "c3"}], "}"}], " ", "/.", 
           " ", "pars"}], ")"}]}], ",", "\n", 
        RowBox[{"\"\<FWHMA0A1A3_cm1\>\"", " ", "->", " ", 
         RowBox[{"2", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "*", 
            RowBox[{"Log", "[", "2", "]"}]}], "]"}], "*", 
          RowBox[{"Abs", "[", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"s0", ",", " ", "s1", ",", " ", "s3"}], "}"}], " ", "/.",
              " ", "pars"}], ")"}], "]"}]}]}], ",", "\n", 
        RowBox[{"\"\<AreasA0A1A3_absorbance_cm1\>\"", " ", "->", " ", 
         "areas"}], ",", "\n", 
        RowBox[{"\"\<PopulationA0A1A3\>\"", " ", "->", " ", "population"}], ",",
         "\n", 
        RowBox[{"\"\<ParameterTable\>\"", " ", "->", " ", 
         RowBox[{"fit", "[", "\"\<ParameterTable\>\"", "]"}]}]}], "\n", 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mbSpectralValidation", " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ftir", ",", " ", "qcl", ",", " ", "predicted", ",", " ", 
       "populationFit"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"ftir", " ", "=", " ", 
       RowBox[{"importSpectrumCSV", "[", 
        RowBox[{"pv", "[", 
         RowBox[{"dataFiles", ",", " ", "\"\<MbCO_FTIR\>\""}], "]"}], "]"}]}],
       ";", "\n", 
      RowBox[{"qcl", " ", "=", " ", 
