Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"lockinStepResponse", "[", 
    RowBox[{"t_", ",", " ", "tau_", ",", " ", "order_Integer"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "t"}], "/", "tau"}], "]"}], "*", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"t", "/", "tau"}], ")"}], "^", "k"}], "/", 
        RowBox[{"k", "!"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "0", ",", " ", 
         RowBox[{"order", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"settlingTime", "[", 
    RowBox[{"tau_", ",", " ", "order_Integer", ",", " ", "target_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"time", " ", "/.", " ", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"lockinStepResponse", "[", 
        RowBox[{"time", ",", " ", "tau", ",", " ", "order"}], "]"}], " ", "==",
        " ", "target"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"time", ",", " ", 
        RowBox[{"order", "*", "tau"}]}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nepbwFactors", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"1", " ", "->", " ", "0.2500"}], ",", " ", 
     RowBox[{"2", " ", "->", " ", "0.1250"}], ",", " ", 
     RowBox[{"3", " ", "->", " ", "0.0937"}], ",", " ", 
     RowBox[{"4", " ", "->", " ", "0.0781"}], ",", " ", 
     RowBox[{"5", " ", "->", " ", "0.0684"}], ",", " ", 
     RowBox[{"6", " ", "->", " ", "0.0615"}], ",", " ", 
     RowBox[{"7", " ", "->", " ", "0.0564"}], ",", " ", 
     RowBox[{"8", " ", "->", " ", "0.0524"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cutoffFactors", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"1", " ", "->", " ", "0.1592"}], ",", " ", 
     RowBox[{"2", " ", "->", " ", "0.1024"}], ",", " ", 
     RowBox[{"3", " ", "->", " ", "0.0811"}], ",", " ", 
     RowBox[{"4", " ", "->", " ", "0.0692"}], ",", " ", 
     RowBox[{"5", " ", "->", " ", "0.0614"}], ",", " ", 
     RowBox[{"6", " ", "->", " ", "0.0557"}], ",", " ", 
     RowBox[{"7", " ", "->", " ", "0.0513"}], ",", " ", 
     RowBox[{"8", " ", "->", " ", "0.0479"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"noiseEquivalentBandwidthHz", "[", 
    RowBox[{"tau_", ",", " ", "order_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"nepbwFactors", "[", "order", "]"}], "/", "tau"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cutoffBandwidthHz", "[", 
    RowBox[{"tau_", ",", " ", "order_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"cutoffFactors", "[", "order", "]"}], "/", "tau"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cascadeStateUpdate", "[", 
    RowBox[{
    "state_", ",", " ", "input_", ",", " ", "dwell_", ",", " ", "tau_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "order", ",", " ", "matrix", ",", " ", "drive", ",", " ", 
       "propagator"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"order", " ", "=", " ", 
       RowBox[{"Length", "[", "state", "]"}]}], ";", "\n", 
      RowBox[{"matrix", " ", "=", " ", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], "/", "tau"}], ",", " ", "order"}], "]"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"order", " ", ">", " ", "1"}], ",", " ", 
        RowBox[{"matrix", " ", "=", " ", 
         RowBox[{"matrix", " ", "+", " ", 
          RowBox[{"SparseArray", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Band", "[", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], " ", "->", " ", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"1", "/", "tau"}], ",", " ", 
               RowBox[{"order", " ", "-", " ", "1"}]}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"order", ",", " ", "order"}], "}"}]}], "]"}]}]}]}], 
       "]"}], ";", "\n", 
      RowBox[{"drive", " ", "=", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", "/", "tau"}], "}"}], ",", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.", ",", " ", 
           RowBox[{"order", " ", "-", " ", "1"}]}], "]"}]}], "]"}]}], ";", 
      "\n", 
      RowBox[{"propagator", " ", "=", " ", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{"matrix", "*", "dwell"}], "]"}]}], ";", "\n", 
      RowBox[{
       RowBox[{"propagator", ".", "state"}], " ", "+", " ", 
       RowBox[{"LinearSolve", "[", 
        RowBox[{"matrix", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"propagator", " ", "-", " ", 
             RowBox[{"IdentityMatrix", "[", "order", "]"}]}], ")"}], ".", 
           "drive"}], "*", "input"}]}], "]"}]}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"simulateSteppedLockin", "[", 
    RowBox[{
    "idealValues_List", ",", " ", "dwell_", ",", " ", "tuningDelay_", ",", 
     " ", "tau_", ",", " ", "order_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"state", ",", " ", "stableDwell", ",", " ", "outputs"}], "}"}], 
     ",", "\n", 
     RowBox[{
      RowBox[{"stableDwell", " ", "=", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"0.", ",", " ", 
         RowBox[{"dwell", " ", "-", " ", "tuningDelay"}]}], "]"}]}], ";", 
      "\n", 
      RowBox[{"state", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"First", "[", "idealValues", "]"}], ",", " ", "order"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"outputs", " ", "=", " ", 
       RowBox[{"Table", "[", "\n", 
        RowBox[{
         RowBox[{
          RowBox[{"state", " ", "=", " ", 
           RowBox[{"cascadeStateUpdate", "[", 
            RowBox[{
            "state", ",", " ", "input", ",", " ", "stableDwell", ",", " ", 
             "tau"}], "]"}]}], ";", "\n", 
          RowBox[{"Last", "[", "state", "]"}]}], ",", "\n", 
         RowBox[{"{", 
          RowBox[{"input", ",", " ", "idealValues"}], "}"}]}], "\n", "]"}]}], 
      ";", "\n", "outputs"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"scanDirectionDistortion", "[", 
    RowBox[{
    "idealSpectrum_", ",", " ", "dwell_", ",", " ", "tuningDelay_", ",", " ", 
     "tau_", ",", " ", "order_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ascending", ",", " ", "descending", ",", " ", "ascendingFiltered", ",",
        " ", "descendingFiltered"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"ascending", " ", "=", " ", 
       RowBox[{"SortBy", "[", 
        RowBox[{"idealSpectrum", ",", " ", "First"}], "]"}]}], ";", "\n", 
      RowBox[{"descending", " ", "=", " ", 
       RowBox[{"Reverse", "[", "ascending", "]"}]}], ";", "\n", 
      RowBox[{"ascendingFiltered", " ", "=", " ", 
       RowBox[{"simulateSteppedLockin", "[", 
        RowBox[{
         RowBox[{"ascending", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", "dwell", ",",
          " ", "tuningDelay", ",", " ", "tau", ",", " ", "order"}], "]"}]}], ";",
       "\n", 
      RowBox[{"descendingFiltered", " ", "=", " ", 
       RowBox[{"simulateSteppedLockin", "[", 
        RowBox[{
         RowBox[{"descending", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", "dwell", ",",
          " ", "tuningDelay", ",", " ", "tau", ",", " ", "order"}], "]"}]}], ";",
       "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<Ascending\>\"", " ", "->", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ascending", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
            "ascendingFiltered"}], "}"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<Descending\>\"", " ", "->", " ", 
         RowBox[{"SortBy", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"descending", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
              "descendingFiltered"}], "}"}], "]"}], ",", " ", "First"}], 
          "]"}]}]}], "\n", "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"scanDirectionPeakShift", "[", 
    RowBox[{
    "idealSpectrum_", ",", " ", "centerGuess_", ",", " ", "halfWindow_", ",", 
     " ", "dwell_", ",", " ", "tuningDelay_", ",", " ", "tau_", ",", " ", 
     "order_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "distorted", ",", " ", "idealFit", ",", " ", "upFit", ",", " ", 
       "downFit"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"distorted", " ", "=", " ", 
       RowBox[{"scanDirectionDistortion", "[", 
        RowBox[{
        "idealSpectrum", ",", " ", "dwell", ",", " ", "tuningDelay", ",", " ",
          "tau", ",", " ", "order"}], "]"}]}], ";", "\n", 
      RowBox[{"idealFit", " ", "=", " ", 
       RowBox[{"fitGaussianPeak", "[", 
        RowBox[{
        "idealSpectrum", ",", " ", "centerGuess", ",", " ", "halfWindow", ",",
          " ", "1"}], "]"}]}], ";", "\n", 
      RowBox[{"upFit", " ", "=", " ", 
       RowBox[{"fitGaussianPeak", "[", 
        RowBox[{
         RowBox[{"distorted", "[", "\"\<Ascending\>\"", "]"}], ",", " ", 
         "centerGuess", ",", " ", "halfWindow", ",", " ", "1"}], "]"}]}], ";",
       "\n", 
      RowBox[{"downFit", " ", "=", " ", 
       RowBox[{"fitGaussianPeak", "[", 
        RowBox[{
         RowBox[{"distorted", "[", "\"\<Descending\>\"", "]"}], ",", " ", 
         "centerGuess", ",", " ", "halfWindow", ",", " ", "1"}], "]"}]}], ";",
       "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<IdealCenter_cm1\>\"", " ", "->", " ", 
