          RowBox[{"upFit", "[", "\"\<Center_cm1\>\"", "]"}], " ", "-", " ", 
          RowBox[{"idealFit", "[", "\"\<Center_cm1\>\"", "]"}]}]}], ",", "\n", 
        RowBox[{"\"\<DescendingShift_cm1\>\"", " ", "->", " ", 
         RowBox[{
          RowBox[{"downFit", "[", "\"\<Center_cm1\>\"", "]"}], " ", "-", " ", 
          RowBox[{"idealFit", "[", "\"\<Center_cm1\>\"", "]"}]}]}], ",", "\n", 
        RowBox[{"\"\<Hysteresis_cm1\>\"", " ", "->", " ", 
         RowBox[{
          RowBox[{"upFit", "[", "\"\<Center_cm1\>\"", "]"}], " ", "-", " ", 
          RowBox[{"downFit", "[", "\"\<Center_cm1\>\"", "]"}]}]}], ",", "\n", 
        RowBox[{"\"\<AscendingFWHM_cm1\>\"", " ", "->", " ", 
