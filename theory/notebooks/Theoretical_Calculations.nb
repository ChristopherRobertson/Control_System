Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"detectorNEPWHzHalf", "[", 
    RowBox[{"areaCm2_", ",", " ", "detectivity_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "areaCm2", "]"}], "/", "detectivity"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"photocurrentA", "[", 
    RowBox[{"probePowerW_", ",", " ", "responsivityAW_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"probePowerW", "*", "responsivityAW"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"detectorNoiseVoltageRMS", "[", 
    RowBox[{
    "nepWHzHalf_", ",", " ", "responsivityAW_", ",", " ", "transimpedanceVA_",
      ",", " ", "bandwidthHz_"}], "]"}], " ", ":=", " ", 
   RowBox[{"nepWHzHalf", "*", "responsivityAW", "*", "transimpedanceVA", "*", 
    RowBox[{"Sqrt", "[", "bandwidthHz", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"shotNoiseVoltageRMS", "[", 
    RowBox[{
    "photocurrentA_", ",", " ", "transimpedanceVA_", ",", " ", 
     "bandwidthHz_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", "*", 
      RowBox[{"pv", "[", 
       RowBox[{"physicalConstants", ",", " ", "\"\<ElementaryCharge_C\>\""}], 
       "]"}], "*", "photocurrentA", "*", "bandwidthHz"}], "]"}], "*", 
    "transimpedanceVA"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"whiteVoltageNoiseRMS", "[", 
    RowBox[{"densityVHzHalf_", ",", " ", "bandwidthHz_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"densityVHzHalf", "*", 
    RowBox[{"Sqrt", "[", "bandwidthHz", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"totalVoltageNoiseRMS", "[", 
    RowBox[{"components_List", ",", " ", "independentAverages_"}], "]"}], " ",
    ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"Total", "[", 
      RowBox[{"components", "^", "2"}], "]"}], "]"}], "/", 
    RowBox[{"Sqrt", "[", "independentAverages", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"expectedNoiseSummary", "[", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "order", ",", " ", "tau", ",", " ", "bandwidth", ",", " ", "nep", ",", 
       " ", "current", ",", " ", "signalVoltage", ",", " ", "components", ",",
        " ", "total"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"order", " ", "=", " ", 
       RowBox[{"Round", "[", 
        RowBox[{"pv", "[", 
         RowBox[{"noiseParameters", ",", " ", "\"\<LockinOrder\>\""}], "]"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"tau", " ", "=", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"noiseParameters", ",", " ", "\"\<LockinTimeConstant_s\>\""}],
         "]"}]}], ";", "\n", 
      RowBox[{"bandwidth", " ", "=", " ", 
       RowBox[{"noiseEquivalentBandwidthHz", "[", 
        RowBox[{"tau", ",", " ", "order"}], "]"}]}], ";", "\n", 
      RowBox[{"nep", " ", "=", " ", 
       RowBox[{"detectorNEPWHzHalf", "[", 
        RowBox[{
         RowBox[{"pv", "[", 
          RowBox[{
          "noiseParameters", ",", " ", "\"\<DetectorActiveArea_cm2\>\""}], 
          "]"}], ",", " ", 
         RowBox[{"pv", "[", 
          RowBox[{
          "noiseParameters", ",", " ", "\"\<Detectivity_cm_HzHalf_W\>\""}], 
          "]"}]}], "]"}]}], ";", "\n", 
      RowBox[{"current", " ", "=", " ", 
       RowBox[{"photocurrentA", "[", 
        RowBox[{
         RowBox[{"pv", "[", 
          RowBox[{
          "noiseParameters", ",", " ", "\"\<IncidentProbePower_W\>\""}], 
          "]"}], ",", " ", 
         RowBox[{"pv", "[", 
          RowBox[{"noiseParameters", ",", " ", "\"\<Responsivity_A_W\>\""}], 
          "]"}]}], "]"}]}], ";", "\n", 
      RowBox[{"signalVoltage", " ", "=", " ", 
       RowBox[{"current", "*", 
        RowBox[{"pv", "[", 
         RowBox[{"noiseParameters", ",", " ", "\"\<Transimpedance_V_A\>\""}], 
         "]"}]}]}], ";", "\n", 
      RowBox[{"components", " ", "=", " ", 
       RowBox[{"{", "\n", 
        RowBox[{
         RowBox[{"detectorNoiseVoltageRMS", "[", 
          RowBox[{"nep", ",", " ", 
           RowBox[{"pv", "[", 
            RowBox[{"noiseParameters", ",", " ", "\"\<Responsivity_A_W\>\""}],
             "]"}], ",", " ", 
           RowBox[{"pv", "[", 
            RowBox[{
            "noiseParameters", ",", " ", "\"\<Transimpedance_V_A\>\""}], 
            "]"}], ",", " ", "bandwidth"}], "]"}], ",", "\n", 
         RowBox[{"shotNoiseVoltageRMS", "[", 
          RowBox[{"current", ",", " ", 
           RowBox[{"pv", "[", 
            RowBox[{
            "noiseParameters", ",", " ", "\"\<Transimpedance_V_A\>\""}], 
            "]"}], ",", " ", "bandwidth"}], "]"}], ",", "\n", 
         RowBox[{"whiteVoltageNoiseRMS", "[", 
          RowBox[{
           RowBox[{"pv", "[", 
            RowBox[{
            "noiseParameters", ",", 
             " ", "\"\<AmplifierVoltageNoise_V_HzHalf\>\""}], "]"}], ",", " ",
            "bandwidth"}], "]"}], ",", "\n", 
         RowBox[{"whiteVoltageNoiseRMS", "[", 
          RowBox[{
           RowBox[{"pv", "[", 
            RowBox[{
            "noiseParameters", ",", " ", "\"\<HF2LIInputNoise_V_HzHalf\>\""}],
             "]"}], ",", " ", "bandwidth"}], "]"}]}], "\n", "}"}]}], ";", 
      "\n", 
      RowBox[{"total", " ", "=", " ", 
       RowBox[{"totalVoltageNoiseRMS", "[", 
        RowBox[{"components", ",", " ", 
         RowBox[{"pv", "[", 
          RowBox[{
          "noiseParameters", ",", " ", "\"\<IndependentAverages\>\""}], 
          "]"}]}], "]"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<NEPBW_Hz\>\"", " ", "->", " ", "bandwidth"}], ",", "\n", 
        RowBox[{"\"\<DetectorNEP_W_HzHalf\>\"", " ", "->", " ", "nep"}], ",", 
        "\n", 
        RowBox[{"\"\<Photocurrent_A\>\"", " ", "->", " ", "current"}], ",", 
        "\n", 
        RowBox[{"\"\<SignalVoltage_V\>\"", " ", "->", " ", "signalVoltage"}], 
        ",", "\n", 
        RowBox[{"\"\<NoiseComponents_V_RMS\>\"", " ", "->", " ", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{
           RowBox[{"{", 
            
            RowBox[{"\"\<Detector\>\"", ",", " ", "\"\<Shot\>\"", ",", 
             " ", "\"\<Amplifier\>\"", ",", " ", "\"\<HF2LI\>\""}], "}"}], ",",
            " ", "components"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<TotalNoise_V_RMS\>\"", " ", "->", " ", "total"}], ",", 
        "\n", 
        RowBox[{"\"\<VoltageSNR\>\"", " ", "->", " ", 
         RowBox[{"signalVoltage", "/", "total"}]}], ",", "\n", 
        RowBox[{"\"\<SmallSignalAbsorbanceNoise\>\"", " ", "->", " ", 
         RowBox[{"total", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Abs", "[", "signalVoltage", "]"}], "*", 
            RowBox[{"Log", "[", "10", "]"}]}], ")"}]}]}]}], "\n", "|>"}]}]}], 
    "\n", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.9959884952746277`*^9},
 CellLabel->
  "In[157]:=",ExpressionUUID->"cd00d564-b245-4e40-9a25-80a654beb6f6"]
