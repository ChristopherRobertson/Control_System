Cell[CellGroupData[{

Cell["18. Mb\[Dash]CO Model Comparison and Repeated-Pulse Test", "Section",ExpressionUUID->"1f61d8bd-6598-5543-a9f6-7b4f7500a1de"],

Cell["\<\
This section determines whether the Mb\[Dash]CO transient supports the added \
geminate branch and whether the measured recovery permits independent \
excitation at the selected repetition rate. Required inputs are the measured \
transient, dissolved-CO concentration, independently entered initial \
photolyzed fraction and single-exponential recovery time, pump repetition \
rate, and target recovery fraction. The same transient is fitted with the \
single-exponential and geminate-plus-bimolecular models, and the comparison \
yields both fit objects, their Akaike information criteria, the \
two-branch-minus-single AIC difference, and adjusted coefficients of \
determination; the fit objects retain residual and parameter information. The \
separately entered slow rate 1/\[Tau]single is then used with the per-pulse \
photolyzed fraction in the steady-state recurrence to calculate the pre-pulse \
and post-pulse unbound fractions, incremental photolysis, fraction recovered \
before the next pulse, and maximum repetition rate compatible with the \
selected recovery criterion; the fitted result is not transferred \
automatically into this calculation. Together, these results quantify whether \
the added kinetic complexity is supported and whether pulse-to-pulse \
carryover is expected under the acquisition conditions. Model selection \
remains conditional on comparison over identical data and error assumptions; \
a lower AIC does not by itself establish a mechanism, and the conclusion also \
depends on residual structure, parameter uncertainty and identifiability, \
temporal resolution, and the single-slow-rate approximation used for the \
accumulation test.\
\>", "Text",ExpressionUUID->"b8a9b27a-cfb1-bc4b-871a-c10e96d9a14e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"kineticModelComparison", "[", 
    RowBox[{"transientData_", ",", " ", "coConcentrationM_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"single", ",", " ", "twoBranch"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"single", " ", "=", " ", 
       RowBox[{"fitSingleExponentialTransient", "[", "transientData", "]"}]}],
       ";", "\n", 
      RowBox[{"twoBranch", " ", "=", " ", 
       RowBox[{"fitTwoBranchTransient", "[", 
        RowBox[{"transientData", ",", " ", "coConcentrationM"}], "]"}]}], ";",
       "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<SingleExponentialFit\>\"", " ", "->", " ", "single"}], ",",
         "\n", 
        RowBox[{"\"\<GeminatePlusBimolecularFit\>\"", " ", "->", " ", 
         "twoBranch"}], ",", "\n", 
        RowBox[{"\"\<SingleAIC\>\"", " ", "->", " ", 
         RowBox[{"single", "[", "\"\<AIC\>\"", "]"}]}], ",", "\n", 
        RowBox[{"\"\<TwoBranchAIC\>\"", " ", "->", " ", 
         RowBox[{"twoBranch", "[", "\"\<AIC\>\"", "]"}]}], ",", "\n", 
        RowBox[{"\"\<DeltaAIC_TwoMinusSingle\>\"", " ", "->", " ", 
         RowBox[{
          RowBox[{"twoBranch", "[", "\"\<AIC\>\"", "]"}], " ", "-", " ", 
          RowBox[{"single", "[", "\"\<AIC\>\"", "]"}]}]}], ",", "\n", 
        RowBox[{"\"\<SingleAdjustedRSquared\>\"", " ", "->", " ", 
         RowBox[{"single", "[", "\"\<AdjustedRSquared\>\"", "]"}]}], ",", 
        "\n", 
        RowBox[{"\"\<TwoBranchAdjustedRSquared\>\"", " ", "->", " ", 
         RowBox[{"twoBranch", "[", "\"\<AdjustedRSquared\>\"", "]"}]}]}], 
       "\n", "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mbRepeatedPulseResult", " ", "=", " ", 
   RowBox[{"safeEvaluate", "[", "\n", 
    RowBox[{"\"\<Mb repeated-pulse accumulation\>\"", ",", "\n", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
       "mbInitialPhotolysis", "[", "\"\<PredictedPhotolyzedFraction\>\"", 
        "]"}], ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"mbParameters", ",", " ", "\"\<SingleExponentialTau_s\>\""}], 
        "]"}], ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"mbParameters", ",", " ", "\"\<PumpRepetitionRate_Hz\>\""}], 
        "]"}], ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"mbParameters", ",", " ", "\"\<TargetRecoveryFraction\>\""}], 
        "]"}]}], "}"}], ",", "\n", 
     RowBox[{"<|", "\n", 
      RowBox[{
       RowBox[{"\"\<SteadyState\>\"", " ", "->", " ", 
        RowBox[{"steadyStatePulseAccumulation", "[", 
         RowBox[{
          RowBox[{
          "mbInitialPhotolysis", "[", "\"\<PredictedPhotolyzedFraction\>\"", 
           "]"}], ",", " ", 
          RowBox[{"1", "/", 
           RowBox[{"pv", "[", 
            RowBox[{
            "mbParameters", ",", " ", "\"\<SingleExponentialTau_s\>\""}], 
            "]"}]}], ",", " ", 
          RowBox[{"pv", "[", 
           RowBox[{
           "mbParameters", ",", " ", "\"\<PumpRepetitionRate_Hz\>\""}], 
           "]"}]}], "]"}]}], ",", "\n", 
       RowBox[{"\"\<MaximumRateForTargetRecovery_Hz\>\"", " ", "->", " ", 
        RowBox[{"maximumRepetitionRateForRecovery", "[", 
         RowBox[{
          RowBox[{"1", "/", 
           RowBox[{"pv", "[", 
            RowBox[{
            "mbParameters", ",", " ", "\"\<SingleExponentialTau_s\>\""}], 
            "]"}]}], ",", " ", 
          RowBox[{"pv", "[", 
           RowBox[{
           "mbParameters", ",", " ", "\"\<TargetRecoveryFraction\>\""}], 
           "]"}]}], "]"}]}]}], "\n", "|>"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"mbRepeatedPulseResult", ";"}], "\n", 
 RowBox[{"If", "[", "\n", 
  RowBox[{
   RowBox[{"readyQ", "[", 
    RowBox[{
     RowBox[{"pv", "[", 
      RowBox[{"dataFiles", ",", " ", "\"\<MbCO_Transient\>\""}], "]"}], ",", 
     " ", 
     RowBox[{"pv", "[", 
      RowBox[{"mbParameters", ",", " ", "\"\<COConcentration_M\>\""}], 
      "]"}]}], "]"}], ",", "\n", 
   RowBox[{"kineticModelComparison", "[", 
    RowBox[{
     RowBox[{"importTransientCSV", "[", 
      RowBox[{"pv", "[", 
       RowBox[{"dataFiles", ",", " ", "\"\<MbCO_Transient\>\""}], "]"}], 
      "]"}], ",", " ", 
     RowBox[{"pv", "[", 
      RowBox[{"mbParameters", ",", " ", "\"\<COConcentration_M\>\""}], 
      "]"}]}], "]"}], ",", "\n", 
   RowBox[{"displayValue", "[", "valueRequired", "]"}]}], "\n", 
  "]"}]}], "Input",
 CellChangeTimes->{3.9959884952014103`*^9},
 CellLabel->
  "In[117]:=",ExpressionUUID->"f55e1c15-7c65-c84d-b4ed-6c4f3758a1ab"],

