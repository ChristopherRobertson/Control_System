Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fitCalibration", "[", 
    RowBox[{"calibrationData_", ",", " ", "polynomialOrder_Integer"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "basis"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"basis", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"x", "^", "power"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"power", ",", " ", "1", ",", " ", "polynomialOrder"}], 
          "}"}]}], "]"}]}], ";", "\n", 
      RowBox[{"LinearModelFit", "[", 
       RowBox[{
        RowBox[{"calibrationData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1"}], "}"}]}], "]"}], "]"}], ",", " ", 
        "basis", ",", " ", "x"}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"calibrationResidualTable", "[", 
    RowBox[{"calibrationData_", ",", " ", "fit_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Map", "[", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"fit", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], " ", "-", " ", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
        RowBox[{"#", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
        RowBox[{"#", "[", 
         RowBox[{"[", "4", "]"}], "]"}], ",", " ", 
        RowBox[{"#", "[", 
         RowBox[{"[", "5", "]"}], "]"}]}], "}"}], " ", "&"}], ",", "\n", 
     "calibrationData"}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"calibrationSummary", "[", 
    RowBox[{"calibrationData_", ",", " ", "fit_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "table", ",", " ", "residual", ",", " ", "directionGroups", ",", " ", 
       "driftFit"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"table", " ", "=", " ", 
       RowBox[{"calibrationResidualTable", "[", 
        RowBox[{"calibrationData", ",", " ", "fit"}], "]"}]}], ";", "\n", 
      RowBox[{"residual", " ", "=", " ", 
       RowBox[{"table", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"directionGroups", " ", "=", " ", 
       RowBox[{"GroupBy", "[", 
        RowBox[{"table", ",", " ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "4", "]"}], "]"}], " ", "&"}], ",", " ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "&"}]}], "]"}]}], ";", "\n", 
      RowBox[{"driftFit", " ", "=", " ", 
       RowBox[{"LinearModelFit", "[", 
        RowBox[{
         RowBox[{"table", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", 
            RowBox[{"{", 
             RowBox[{"5", ",", " ", "3"}], "}"}]}], "]"}], "]"}], ",", " ", 
         "elapsed", ",", " ", "elapsed"}], "]"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<FitParameters\>\"", " ", "->", " ", 
         RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}], ",", "\n", 
        RowBox[{"\"\<ParameterTable\>\"", " ", "->", " ", 
         RowBox[{"fit", "[", "\"\<ParameterTable\>\"", "]"}]}], ",", "\n", 
        RowBox[{"\"\<MeanSignedError_cm1\>\"", " ", "->", " ", 
         RowBox[{"Mean", "[", "residual", "]"}]}], ",", "\n", 
        RowBox[{"\"\<RMSD_cm1\>\"", " ", "->", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Mean", "[", 
           RowBox[{"residual", "^", "2"}], "]"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<MaximumAbsoluteError_cm1\>\"", " ", "->", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", "residual", "]"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<DirectionMeanResiduals_cm1\>\"", " ", "->", " ", 
         RowBox[{"Map", "[", 
          RowBox[{"Mean", ",", " ", "directionGroups"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<DriftSlope_cm1_per_s\>\"", " ", "->", " ", 
         RowBox[{"Last", "[", 
          RowBox[{"driftFit", "[", "\"\<BestFitParameters\>\"", "]"}], 
          "]"}]}]}], "\n", "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"repeatabilityTable", "[", "calibrationData_", "]"}], " ", ":=", 
   " ", 
   RowBox[{"KeyValueMap", "[", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#1", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"#1", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
        RowBox[{"Mean", "[", "#2", "]"}], ",", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "#2", "]"}], " ", ">", " ", "1"}], ",", " ", 
          RowBox[{"StandardDeviation", "[", "#2", "]"}], ",", " ", 
          RowBox[{"Missing", "[", "\"\<InsufficientReplicates\>\"", "]"}]}], 
         "]"}]}], "}"}], " ", "&"}], ",", "\n", 
     RowBox[{"GroupBy", "[", 
      RowBox[{"calibrationData", ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "}"}], " ", "&"}], ",", " ", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], " ", "&"}]}], "]"}]}], "\n", "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hysteresisTable", "[", "calibrationData_", "]"}], " ", ":=", " ", 
   RowBox[{"KeyValueMap", "[", "\n", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"reference", ",", " ", "rows"}], "}"}], ",", " ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"groups", " ", "=", " ", 
           RowBox[{"GroupBy", "[", 
            RowBox[{"rows", ",", " ", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "3", "]"}], "]"}], " ", "&"}], ",", " ", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", "&"}]}], "]"}]}], "}"}], ",",
          "\n", 
         RowBox[{"{", 
          RowBox[{"reference", ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"KeyExistsQ", "[", 
               RowBox[{"groups", ",", " ", "1."}], "]"}], " ", "&&", " ", 
              RowBox[{"KeyExistsQ", "[", 
               RowBox[{"groups", ",", " ", 
                RowBox[{"-", "1."}]}], "]"}]}], ",", " ", 
             RowBox[{
              RowBox[{"Mean", "[", 
               RowBox[{"groups", "[", "1.", "]"}], "]"}], " ", "-", " ", 
              RowBox[{"Mean", "[", 
               RowBox[{"groups", "[", 
                RowBox[{"-", "1."}], "]"}], "]"}]}], ",", " ", 
             RowBox[{
             "Missing", "[", "\"\<BothDirectionsRequired\>\"", "]"}]}], 
            "]"}]}], "}"}]}], "\n", "]"}]}], "]"}], ",", "\n", 
     RowBox[{"GroupBy", "[", 
      RowBox[{"calibrationData", ",", " ", "First"}], "]"}]}], "\n", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{3.995988495026476*^9},
 CellLabel->"In[37]:=",ExpressionUUID->"fecaa06f-5b2e-3647-b600-3dcf44c17d7c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"calibrationRun", " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", ",", " ", "fit"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"data", " ", "=", " ", 
       RowBox[{"importCalibrationCSV", "[", 
        RowBox[{"pv", "[", 
         RowBox[{"dataFiles", ",", " ", "\"\<CalibrationPeaks\>\""}], "]"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"fit", " ", "=", " ", 
       RowBox[{"fitCalibration", "[", 
        RowBox[{"data", ",", " ", 
         RowBox[{"Round", "[", 
          RowBox[{"pv", "[", 
           RowBox[{
           "calibrationParameters", ",", " ", "\"\<PolynomialOrder\>\""}], 
           "]"}], "]"}]}], "]"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<Summary\>\"", " ", "->", " ", 
         RowBox[{"calibrationSummary", "[", 
          RowBox[{"data", ",", " ", "fit"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<ResidualTableColumns\>\"", " ", "->", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Reference_cm-1\>\"", ",", " ", "\"\<QCLPeak_cm-1\>\"", 
           ",", " ", "\"\<Residual_cm-1\>\"", ",", 
           " ", "\"\<DirectionCode\>\"", ",", " ", "\"\<ElapsedTime_s\>\"", ",",
            " ", "\"\<ReplicateID\>\""}], "}"}]}], ",", "\n", 
        RowBox[{"\"\<ResidualTable\>\"", " ", "->", " ", 
         RowBox[{"calibrationResidualTable", "[", 
          RowBox[{"data", ",", " ", "fit"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<Repeatability\>\"", " ", "->", " ", 
         RowBox[{"repeatabilityTable", "[", "data", "]"}]}], ",", "\n", 
        RowBox[{"\"\<Hysteresis\>\"", " ", "->", " ", 
         RowBox[{"hysteresisTable", "[", "data", "]"}]}]}], "\n", "|>"}]}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"readyQ", "[", 
    RowBox[{"pv", "[", 
     RowBox[{"dataFiles", ",", " ", "\"\<CalibrationPeaks\>\""}], "]"}], 
    "]"}], ",", " ", "calibrationRun", ",", " ", 
   RowBox[{"displayValue", "[", "valueRequired", "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{3.9959884950311737`*^9},
 CellLabel->"In[42]:=",ExpressionUUID->"31791b60-17ff-5943-af3d-a926283d067d"],

