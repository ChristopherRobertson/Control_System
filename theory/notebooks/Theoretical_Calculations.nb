      RowBox[{"fullFit", " ", "=", " ", 
       RowBox[{"fitHRPPocketSolventTransient", "[", "\n", 
        RowBox[{"transientData", ",", " ", "co", ",", "\n", 
         RowBox[{"pv", "[", 
          RowBox[{
          "hrpParameters", ",", " ", "\"\<FitInitialGeminateRate_s1\>\""}], 
          "]"}], ",", "\n", 
         RowBox[{"pv", "[", 
          RowBox[{
          "hrpParameters", ",", " ", "\"\<FitInitialEscapeRate_s1\>\""}], 
          "]"}], ",", "\n", 
         RowBox[{"pv", "[", 
          RowBox[{
          "hrpParameters", ",", " ", "\"\<FitInitialOnRate_M1_s1\>\""}], 
          "]"}]}], "\n", "]"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<SolventOnlyFit\>\"", " ", "->", " ", "solventFit"}], ",",
         "\n", 
        RowBox[{"\"\<PocketPlusSolventFit\>\"", " ", "->", " ", "fullFit"}], ",",
         "\n", 
        RowBox[{"\"\<SolventOnlyAIC\>\"", " ", "->", " ", 
         RowBox[{"solventFit", "[", "\"\<AIC\>\"", "]"}]}], ",", "\n", 
        RowBox[{"\"\<PocketPlusSolventAIC\>\"", " ", "->", " ", 
         RowBox[{"fullFit", "[", "\"\<AIC\>\"", "]"}]}], ",", "\n", 
        RowBox[{"\"\<DeltaAIC_FullMinusSolvent\>\"", " ", "->", " ", 
         RowBox[{
          RowBox[{"fullFit", "[", "\"\<AIC\>\"", "]"}], " ", "-", " ", 
          RowBox[{"solventFit", "[", "\"\<AIC\>\"", "]"}]}]}]}], "\n", 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"If", "[", "\n", 
  RowBox[{
   RowBox[{"readyQ", "[", 
    RowBox[{
     RowBox[{"pv", "[", 
