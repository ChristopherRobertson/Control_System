Cell[CellGroupData[{

Cell["22. Detector, Electronics, and Expected Noise", "Section",ExpressionUUID->"330ecec3-0341-b24a-ae46-b635e8e01f45"],

Cell[TextData[{
 "This section separates the expected detector, photon-shot, amplifier, and \
HF2LI noise contributions under the acquisition conditions. The inputs \
comprise the active detector area, wavelength- and frequency-matched specific \
detectivity and current responsivity, incident probe power, selected \
transimpedance, amplifier and HF2LI voltage-noise densities referred to the \
same electrical node as the computed signal voltage, lock-in time constant \
and order, and number of statistically independent averages. The VIGO \
documentation provides model-dependent active area, detectivity, current \
responsivity, and compatible-amplifier transimpedance specifications, while \
the entered values correspond to the exact installed variant and acquisition \
conditions.",
 StyleBox["11",
  FontVariations -> {"Superscript" -> True}],
 " The detector noise-equivalent power is obtained as \[Sqrt]A/D*, the \
photocurrent as optical power times responsivity, and each white-noise \
density is integrated over the order-dependent lock-in noise-equivalent \
bandwidth. The defined summary function reports bandwidth, detector NEP, \
photocurrent, signal voltage, the individual pre-averaging RMS noise \
components, their quadrature total divided by \[Sqrt]N, voltage SNR, and \
small-signal absorbance noise, providing a quantitative noise floor for \
comparison with measured performance. Detectivity and responsivity are valid \
only at their stated wavelength, frequency, temperature, and detector \
variant, and the calculation assumes white, mutually independent noise and \
independent averages; correlated source noise, low-frequency drift, gain-node \
mismatches, and saturation are not represented."
}], "Text",
 CellChangeTimes->{
  3.995988494930464*^9},ExpressionUUID->"f79a33af-495f-7346-a0e5-\
d423e986c4a2"],

Cell[BoxData[
 RowBox[{"NEP", " ", "==", " ", "Sqrt", "[", "detectorArea", "]", "/", 
  "detectivity"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"13c763fc-0be0-8e47-ab79-b2a10c330c79"],

Cell[BoxData[
 RowBox[{"shotCurrentNoise", " ", "==", " ", "Sqrt", "[", 
  RowBox[{"2", "*", "elementaryCharge", "*", "photocurrent", "*", "NEPBW"}], 
  "]"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"d3e54f2c-9440-2045-b42a-ee45068324cc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"noiseParameters", " ", "=", " ", 
   RowBox[{"<|", "\n", 
    RowBox[{
     RowBox[{"\"\<DetectorActiveArea_cm2\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<cm^2\>\"", ",", 
        " ", "\"\<Photosensitive area of installed MCT detector\>\"", ",", 
        " ", "\"\<Exact installed model\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<Detectivity_cm_HzHalf_W\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<cm Hz^(1/2) W^-1\>\"", ",", 
        " ", "\"\<Specific detectivity at the probe wavelength and modulation \
frequency\>\"", ",", " ", "\"\<Exact installed model or measured\>\""}], 
       "]"}]}], ",", "\n", 
     RowBox[{"\"\<Responsivity_A_W\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<A W^-1\>\"", ",", 
        " ", "\"\<Detector current responsivity at the probe wavelength\>\"", 
        ",", " ", "\"\<Exact installed model or measured\>\""}], "]"}]}], ",",
      "\n", 
     RowBox[{"\"\<IncidentProbePower_W\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<W\>\"", ",", 
        " ", "\"\<Average optical power at the detector under the acquisition \
condition\>\"", ",", " ", "\"\<Measured\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<Transimpedance_V_A\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<V A^-1\>\"", ",", 
        " ", "\"\<Detector amplifier transimpedance\>\"", ",", 
        " ", "\"\<Exact gain setting\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<AmplifierVoltageNoise_V_HzHalf\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<V Hz^-1/2\>\"", ",", 
        " ", "\"\<Input-referred amplifier/electronics voltage noise\>\"", ",",
         " ", "\"\<Measured or specified\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<HF2LIInputNoise_V_HzHalf\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<V Hz^-1/2\>\"", ",", 
        " ", "\"\<HF2LI input voltage noise under the used range and \
frequency\>\"", ",", " ", "\"\<Measured or specified\>\""}], "]"}]}], ",", 
     "\n", 
     RowBox[{"\"\<LockinTimeConstant_s\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<s\>\"", ",", 
        " ", "\"\<HF2LI time constant\>\"", ",", 
        " ", "\"\<Experimental setting\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<LockinOrder\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<integer 1\[Dash]8\>\"", ",", 
        " ", "\"\<HF2LI low-pass order\>\"", ",", 
        " ", "\"\<Experimental setting\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<IndependentAverages\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<count\>\"", ",", 
        " ", "\"\<Number of statistically independent averages\>\"", ",", 
        " ", "\"\<Acquisition method\>\""}], "]"}]}]}], "\n", "|>"}]}], 
  ";"}], "\n", 
 RowBox[{"parameterTable", "[", "noiseParameters", "]"}]}], "Input",
 CellChangeTimes->{3.9959884952671127`*^9},
 CellLabel->
  "In[155]:=",ExpressionUUID->"f2e7ba8d-fb7a-ab45-aa70-e3969f03c829"],

