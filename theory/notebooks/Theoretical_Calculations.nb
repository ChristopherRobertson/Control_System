Cell[CellGroupData[{

Cell["6. Gaussian Peak Fits and Effective Spectral Resolution", "Section",ExpressionUUID->"d95895ac-40dd-ff4d-ad30-2955f8ac5870"],

Cell["\<\
This section quantifies spectral peak positions, widths, areas, and the \
effective spectral resolution represented by the FTIR and QCL measurements. \
The required inputs are the spectral data, approximate peak centers, fitting \
half-window, peak sign, FTIR instrument width, QCL and calibration width \
contributions, and QCL sampling interval. Within each specified window, a \
nonlinear least-squares fit combines a sloping baseline with a Gaussian peak \
whose center is constrained to the window and whose standard deviation is \
positive; the peak-sign input controls the amplitude starting estimate rather \
than imposing a sign constraint. The fit returns the center, amplitude, \
Gaussian standard deviation, full width at half maximum, integrated area, and \
parameter table, and paired FTIR and QCL fits then provide center and width \
differences. Under the Gaussian approximation, the effective QCL instrument \
width is obtained by subtracting the FTIR-observed sample width in quadrature \
while restoring the FTIR instrument contribution, with a negative radicand \
clipped to zero. The combined-resolution function accepts standard-deviation \
contributions for the sample, QCL, and calibration terms and adds the \
uniform-step sampling term represented by the step divided by \[Sqrt]12. \
These outputs separate peak displacement from instrumental broadening and \
define the spectral resolution relevant to comparisons with the FTIR \
reference. Lorentzian and Voigt alternatives are not included in the present \
model, so interpretation is limited to peaks adequately represented by a \
Gaussian line shape and local linear baseline.\
\>", "Text",ExpressionUUID->"c8090715-e939-a847-9386-f469dec00e9f"],

Cell[BoxData[
 RowBox[{"G", "[", "nu", "]", " ", "==", " ", "b0", " ", "+", " ", "b1", "*", 
  "(", 
  RowBox[{"nu", " ", "-", " ", "nu0"}], ")", " ", "+", " ", "amplitude", "*", 
  "Exp", "[", 
  RowBox[{"-", "(", 
   RowBox[{"nu", " ", "-", " ", "center"}], ")", "^", "2", "/", "(", 
   RowBox[{"2", "*", "sigma", "^", "2"}], ")"}], "]"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"55282282-f7fb-1549-b214-d8dfc5fab202"],

Cell[BoxData[
 RowBox[{"FWHM", " ", "==", " ", "2", "*", "Sqrt", "[", 
  RowBox[{"2", "*", "Log", "[", "2", "]"}], "]", "*", 
  "sigma"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"212306f6-2a2e-4c44-80a4-80d7ad8a8dc9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fitGaussianPeak", "[", 
    RowBox[{
    "data_", ",", " ", "centerGuess_", ",", " ", "halfWindow_", ",", " ", 
     RowBox[{"sign_", ":", " ", "1"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "subset", ",", " ", "x", ",", " ", "b0", ",", " ", "b1", ",", " ", 
       "amp", ",", " ", "center", ",", " ", "sigma", ",", " ", "ampGuess", ",",
        " ", "fit", ",", " ", "pars"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"subset", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{"data", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"centerGuess", " ", "-", " ", "halfWindow"}], " ", "<=", 
           " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "<=", " ", 
           RowBox[{"centerGuess", " ", "+", " ", "halfWindow"}]}], " ", 
          "&"}]}], "]"}]}], ";", "\n", 
      RowBox[{"ampGuess", " ", "=", " ", 
       RowBox[{"sign", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"subset", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], " ", "-", 
          " ", 
          RowBox[{"Min", "[", 
           RowBox[{"subset", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}], ")"}]}]}],
       ";", "\n", 
      RowBox[{"fit", " ", "=", " ", 
       RowBox[{"NonlinearModelFit", "[", "\n", 
        RowBox[{"subset", ",", "\n", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"b0", " ", "+", " ", 
            RowBox[{"b1", "*", 
             RowBox[{"(", 
              RowBox[{"x", " ", "-", " ", "centerGuess"}], ")"}]}], " ", "+", 
            " ", 
            RowBox[{"amp", "*", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"x", " ", "-", " ", "center"}], ")"}], "^", "2"}]}],
                "/", 
               RowBox[{"(", 
                RowBox[{"2", "*", 
                 RowBox[{"sigma", "^", "2"}]}], ")"}]}], "]"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{"sigma", " ", ">", " ", "0"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"centerGuess", " ", "-", " ", "halfWindow"}], " ", "<=", 
             " ", "center", " ", "<=", " ", 
             RowBox[{"centerGuess", " ", "+", " ", "halfWindow"}]}]}]}], 
          "}"}], ",", "\n", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"b0", ",", " ", 
             RowBox[{"Median", "[", 
              RowBox[{"subset", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "}"}], 
           ",", " ", 
           RowBox[{"{", 
            RowBox[{"b1", ",", " ", "0."}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"amp", ",", " ", "ampGuess"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"center", ",", " ", "centerGuess"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"sigma", ",", " ", 
             RowBox[{"halfWindow", "/", "4"}]}], "}"}]}], "}"}], ",", "\n", 
         "x"}], "\n", "]"}]}], ";", "\n", 
      RowBox[{"pars", " ", "=", " ", 
       RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<Fit\>\"", " ", "->", " ", "fit"}], ",", "\n", 
        RowBox[{
         RowBox[{"\"\<Center_cm1\>\"", " ", "->", " ", "center"}], " ", "/.", 
         " ", "pars"}], ",", "\n", 
        RowBox[{
         RowBox[{"\"\<Amplitude_absorbance\>\"", " ", "->", " ", "amp"}], " ",
          "/.", " ", "pars"}], ",", "\n", 
        RowBox[{
         RowBox[{"\"\<Sigma_cm1\>\"", " ", "->", " ", "sigma"}], " ", "/.", 
         " ", "pars"}], ",", "\n", 
        RowBox[{"\"\<FWHM_cm1\>\"", " ", "->", " ", 
         RowBox[{"2", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "*", 
            RowBox[{"Log", "[", "2", "]"}]}], "]"}], "*", 
          RowBox[{"Abs", "[", 
           RowBox[{"sigma", " ", "/.", " ", "pars"}], "]"}]}]}], ",", "\n", 
        RowBox[{"\"\<IntegratedArea_absorbance_cm1\>\"", " ", "->", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"amp", " ", "/.", " ", "pars"}], ")"}], "*", 
          RowBox[{"Abs", "[", 
           RowBox[{"sigma", " ", "/.", " ", "pars"}], "]"}], "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "*", "Pi"}], "]"}]}]}], ",", "\n", 
        RowBox[{"\"\<ParameterTable\>\"", " ", "->", " ", 
         RowBox[{"fit", "[", "\"\<ParameterTable\>\"", "]"}]}]}], "\n", 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fitPeakList", "[", 
    RowBox[{"data_", ",", " ", "centers_", ",", " ", "halfWindow_", ",", " ", 
     RowBox[{"sign_", ":", " ", "1"}]}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"fitGaussianPeak", "[", 
      RowBox[{
      "data", ",", " ", "#", ",", " ", "halfWindow", ",", " ", "sign"}], 
      "]"}], " ", "&"}], " ", "/@", " ", "centers"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"peakComparison", "[", 
    RowBox[{"ftirFits_", ",", " ", "qclFits_"}], "]"}], " ", ":=", " ", 
   RowBox[{"MapThread", "[", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<FTIRCenter_cm1\>\"", " ", "->", " ", 
         RowBox[{"#1", "[", "\"\<Center_cm1\>\"", "]"}]}], ",", "\n", 
        RowBox[{"\"\<QCLCenter_cm1\>\"", " ", "->", " ", 
         RowBox[{"#2", "[", "\"\<Center_cm1\>\"", "]"}]}], ",", "\n", 
        RowBox[{"\"\<CenterDifference_cm1\>\"", " ", "->", " ", 
         RowBox[{
          RowBox[{"#2", "[", "\"\<Center_cm1\>\"", "]"}], " ", "-", " ", 
          RowBox[{"#1", "[", "\"\<Center_cm1\>\"", "]"}]}]}], ",", "\n", 
        RowBox[{"\"\<FTIRFWHM_cm1\>\"", " ", "->", " ", 
         RowBox[{"#1", "[", "\"\<FWHM_cm1\>\"", "]"}]}], ",", "\n", 
        RowBox[{"\"\<QCLFWHM_cm1\>\"", " ", "->", " ", 
         RowBox[{"#2", "[", "\"\<FWHM_cm1\>\"", "]"}]}], ",", "\n", 
        RowBox[{"\"\<FWHMDifference_cm1\>\"", " ", "->", " ", 
         RowBox[{
          RowBox[{"#2", "[", "\"\<FWHM_cm1\>\"", "]"}], " ", "-", " ", 
          RowBox[{"#1", "[", "\"\<FWHM_cm1\>\"", "]"}]}]}]}], "\n", "|>"}], 
      " ", "&"}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{"ftirFits", ",", " ", "qclFits"}], "}"}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussianInstrumentFWHM", "[", 
    RowBox[{
    "qclObservedFWHM_", ",", " ", "ftirObservedFWHM_", ",", " ", 
     "ftirInstrumentFWHM_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Sqrt", "[", "\n", 
    RowBox[{"Max", "[", 
     RowBox[{"0.", ",", " ", 
      RowBox[{
       RowBox[{"qclObservedFWHM", "^", "2"}], " ", "-", " ", 
       RowBox[{"ftirObservedFWHM", "^", "2"}], " ", "+", " ", 
       RowBox[{"ftirInstrumentFWHM", "^", "2"}]}]}], "]"}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"samplingSigma", "[", "stepCm1_", "]"}], " ", ":=", " ", 
   RowBox[{"stepCm1", "/", 
    RowBox[{"Sqrt", "[", "12", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"combinedResolutionSigma", "[", 
    RowBox[{
    "sampleSigma_", ",", " ", "qclSigma_", ",", " ", "calibrationSigma_", ",",
      " ", "stepCm1_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Sqrt", "[", "\n", 
    RowBox[{
     RowBox[{"sampleSigma", "^", "2"}], " ", "+", " ", 
     RowBox[{"qclSigma", "^", "2"}], " ", "+", " ", 
     RowBox[{"calibrationSigma", "^", "2"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"samplingSigma", "[", "stepCm1", "]"}], "^", "2"}]}], "\n", 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.995988495040344*^9},
 CellLabel->"In[44]:=",ExpressionUUID->"481c94d0-5c52-e54c-a876-c496c4699f4a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Polystyrene Forward Prediction", "Section",ExpressionUUID->"fed63081-516d-5842-8d97-86ed282b2b66"],

Cell["\<\
This section evaluates the internal consistency of the spectral forward model \
using the polystyrene calibration specimen. The executable comparison \
requires the high-resolution polystyrene FTIR spectrum, measured QCL \
spectrum, independently specified QCL linewidth, selected FTIR reference-peak \
centers, and Gaussian fitting half-window. Film thickness and the Napierian \
absorption coefficient support the separate absolute-absorbance relation but \
are not consumed by polystyreneRun; refractive index and incidence angle \
enter the interference analysis in Section 9, and the number of averaged \
spectra remains acquisition metadata. Any literature-derived polystyrene \
optical constants are attributed to [CITATION NEEDED]. The FTIR spectrum is \
convolved in transmission space at the measured QCL setpoints, converted back \
to absorbance, and compared with the QCL spectrum through a residual \
spectrum, root-mean-square error, mean and maximum residuals, correlation, \
and paired Gaussian peak centers and widths. An overlay of the FTIR, measured \
QCL, and predicted QCL spectra provides the corresponding graphical \
comparison. These results test whether the observed polystyrene spectrum \
follows from the independently specified spectral response and expose \
discrepancies in wavenumber alignment, linewidth, or line-shape transfer. \
Absolute film absorbance is physically interpretable only when thickness and \
absorption coefficient are independently established, and these quantities \
are not adjusted to force agreement with the QCL measurement.\
\>", "Text",ExpressionUUID->"7230435d-93c1-6a46-b911-0b67d02e0787"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"polystyreneParameters", " ", "=", " ", 
   RowBox[{"<|", "\n", 
    RowBox[{
     RowBox[{"\"\<Thickness_cm\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<cm\>\"", ",", 
        " ", "\"\<Polystyrene film thickness\>\"", ",", 
        " ", "\"\<Measured\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<RefractiveIndex\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<dimensionless\>\"", ",", 
        " ", "\"\<Refractive index in the measured region\>\"", ",", 
        " ", "\"\<Measured or cited\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<IncidenceAngle_deg\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<degree\>\"", ",", 
        " ", "\"\<External incidence angle\>\"", ",", 
        " ", "\"\<Measured\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<ReferencePeakCenters_cm1\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<list of cm^-1\>\"", ",", 
        " ", "\"\<Peak centers selected from the FTIR reference\>\"", ",", 
        " ", "\"\<Reader input\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<AbsorptionCoefficient_cm1\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<cm^-1 or function\>\"", ",", 
        " ", "\"\<Napierian absorption coefficient for absolute \
absorbance\>\"", ",", " ", "\"\<Measured or cited\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<NumberOfAverages\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<count\>\"", ",", 
        " ", "\"\<QCL spectra averaged\>\"", ",", 
        " ", "\"\<Reader input\>\""}], "]"}]}]}], "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{"parameterTable", "[", "polystyreneParameters", "]"}]}], "Input",
 CellChangeTimes->{3.995988495045536*^9},
 CellLabel->"In[50]:=",ExpressionUUID->"bcf9cf93-ed6e-cc40-8198-f0f1dce5cf1a"],

