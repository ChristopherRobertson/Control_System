Cell[CellGroupData[{

Cell["13. HRP\[Dash]CO Repeated-Pulse Accumulation", "Section",ExpressionUUID->"ee93cd5d-bedd-5f44-8759-fe83e70bc2b4"],

Cell["\<\
This section evaluates whether incomplete HRP\[Dash]CO recovery between pump \
pulses produces a persistent photolyzed population. Required inputs are the \
predicted photolyzed fraction per pulse, the pseudo-first-order recovery rate \
kon[CO], pump repetition rate, and specified target recovery fraction. The \
inter-pulse decay factor is calculated as exp(\[Minus]krecovery/frep), and \
the resulting geometric recurrence is solved at steady state to determine the \
unbound fractions immediately before and after each pulse. The calculated \
outputs are the steady-state pre-pulse and post-pulse unbound fractions, \
incremental photolysis produced by each pulse, fraction recovered before the \
next pulse, and maximum repetition rate compatible with the selected recovery \
criterion. These quantities establish whether the 10 Hz excitation condition \
preserves an effectively recovered dark-state baseline or instead produces \
pulse-to-pulse accumulation that changes the apparent transient amplitude. \
The calculation uses the single observable solvent-rebinding rate and \
therefore represents the slow recovery limit of the HRP model. Its valid \
domain assumes a per-pulse photolyzed fraction between zero and one, positive \
recovery and repetition rates, and a target recovery strictly between zero \
and one; these domains are not enforced by the helper functions. Additional \
long-lived states, irreversible photochemistry, sample exchange, \
photobleaching, or a demonstrably multiexponential inter-pulse recovery would \
require a more complete recurrence than the one evaluated here.\
\>", "Text",ExpressionUUID->"a8fba55e-13ee-4d4f-9f73-e93bf022d996"],

Cell[BoxData[
 RowBox[{"postSS", " ", "==", " ", "photolysisPerPulse", "/", "(", 
  RowBox[{"1", " ", "-", " ", "(", 
   RowBox[{"1", " ", "-", " ", "photolysisPerPulse"}], ")", "*", "Exp", "[", 
   RowBox[{"-", "kRecovery", "/", "pumpRate"}], "]"}], 
  ")"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"806b512b-c2c7-484a-8b9f-79bc884cb9f8"],

Cell[BoxData[
 RowBox[{"preSS", " ", "==", " ", "postSS", "*", "Exp", "[", 
  RowBox[{"-", "kRecovery", "/", "pumpRate"}], "]"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"1a124894-39bd-0345-9ff1-c318ea5b3ea3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"steadyStatePulseAccumulation", "[", 
    RowBox[{
    "photolysisPerPulse_", ",", " ", "recoveryRateS1_", ",", " ", 
     "repetitionRateHz_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"decay", ",", " ", "post", ",", " ", "pre"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"decay", " ", "=", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "recoveryRateS1"}], "/", "repetitionRateHz"}], "]"}]}], 
      ";", "\n", 
      RowBox[{"post", " ", "=", " ", 
       RowBox[{"photolysisPerPulse", "/", 
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", "photolysisPerPulse"}], ")"}], "*", 
           "decay"}]}], ")"}]}]}], ";", "\n", 
      RowBox[{"pre", " ", "=", " ", 
       RowBox[{"post", "*", "decay"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<PrePulseUnboundFraction\>\"", " ", "->", " ", "pre"}], ",",
         "\n", 
        RowBox[{"\"\<PostPulseUnboundFraction\>\"", " ", "->", " ", "post"}], 
        ",", "\n", 
        RowBox[{"\"\<IncrementalPhotolysisPerPulse\>\"", " ", "->", " ", 
         RowBox[{"post", " ", "-", " ", "pre"}]}], ",", "\n", 
        RowBox[{"\"\<RecoveredFractionBeforeNextPulse\>\"", " ", "->", " ", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"pre", "/", "post"}]}]}]}], "\n", "|>"}]}]}], "\n", "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maximumRepetitionRateForRecovery", "[", 
    RowBox[{"recoveryRateS1_", ",", " ", "targetRecoveryFraction_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"recoveryRateS1", "/", 
    RowBox[{"(", 
     RowBox[{"-", 
      RowBox[{"Log", "[", 
       RowBox[{"1", " ", "-", " ", "targetRecoveryFraction"}], "]"}]}], 
     ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{3.9959884951369286`*^9},
 CellLabel->"In[93]:=",ExpressionUUID->"19e516df-4357-1442-8b44-d65f6f8f8639"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hrpRepeatedPulseResult", " ", "=", " ", 
   RowBox[{"safeEvaluate", "[", "\n", 
    RowBox[{"\"\<HRP repeated-pulse accumulation\>\"", ",", "\n", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
       "hrpInitialPhotolysis", "[", "\"\<PredictedPhotolyzedFraction\>\"", 
        "]"}], ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{
        "hrpParameters", ",", " ", "\"\<BimolecularOnRate_M1_s1\>\""}], "]"}],
        ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"hrpParameters", ",", " ", "\"\<COConcentration_M\>\""}], 
        "]"}], ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"hrpParameters", ",", " ", "\"\<PumpRepetitionRate_Hz\>\""}], 
        "]"}], ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"hrpParameters", ",", " ", "\"\<TargetRecoveryFraction\>\""}],
         "]"}]}], "}"}], ",", "\n", 
     RowBox[{"<|", "\n", 
      RowBox[{
       RowBox[{"\"\<SteadyState\>\"", " ", "->", " ", 
        RowBox[{"steadyStatePulseAccumulation", "[", "\n", 
         RowBox[{
          RowBox[{
          "hrpInitialPhotolysis", "[", "\"\<PredictedPhotolyzedFraction\>\"", 
           "]"}], ",", "\n", 
          RowBox[{
           RowBox[{"pv", "[", 
            RowBox[{
            "hrpParameters", ",", " ", "\"\<BimolecularOnRate_M1_s1\>\""}], 
            "]"}], "*", 
           RowBox[{"pv", "[", 
            RowBox[{"hrpParameters", ",", " ", "\"\<COConcentration_M\>\""}], 
            "]"}]}], ",", "\n", 
          RowBox[{"pv", "[", 
           RowBox[{
           "hrpParameters", ",", " ", "\"\<PumpRepetitionRate_Hz\>\""}], 
           "]"}]}], "\n", "]"}]}], ",", "\n", 
       RowBox[{"\"\<MaximumRateForTargetRecovery_Hz\>\"", " ", "->", " ", 
        RowBox[{"maximumRepetitionRateForRecovery", "[", "\n", 
         RowBox[{
          RowBox[{
           RowBox[{"pv", "[", 
            RowBox[{
            "hrpParameters", ",", " ", "\"\<BimolecularOnRate_M1_s1\>\""}], 
            "]"}], "*", 
           RowBox[{"pv", "[", 
            RowBox[{"hrpParameters", ",", " ", "\"\<COConcentration_M\>\""}], 
            "]"}]}], ",", "\n", 
          RowBox[{"pv", "[", 
           RowBox[{
           "hrpParameters", ",", " ", "\"\<TargetRecoveryFraction\>\""}], 
           "]"}]}], "\n", "]"}]}]}], "\n", "|>"}]}], "\n", "]"}]}], 
  ";"}], "\n", "hrpRepeatedPulseResult"}], "Input",
 CellChangeTimes->{3.9959884951416264`*^9},
 CellLabel->"In[95]:=",ExpressionUUID->"d763e89e-1a29-5b4d-a24c-48587eea0cd8"],

