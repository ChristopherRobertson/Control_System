Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"polystyreneRun", " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ftir", ",", " ", "qcl", ",", " ", "grid", ",", " ", "predicted", ",", 
       " ", "residual", ",", " ", "metrics", ",", " ", "centers", ",", " ", 
       "halfWindow", ",", " ", "ftirFits", ",", " ", "qclFits"}], "}"}], ",", 
     "\n", 
     RowBox[{
      RowBox[{"ftir", " ", "=", " ", 
       RowBox[{"importSpectrumCSV", "[", 
        RowBox[{"pv", "[", 
         RowBox[{"dataFiles", ",", " ", "\"\<Polystyrene_FTIR\>\""}], "]"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"qcl", " ", "=", " ", 
       RowBox[{"importSpectrumCSV", "[", 
        RowBox[{"pv", "[", 
         RowBox[{"dataFiles", ",", " ", "\"\<Polystyrene_QCL\>\""}], "]"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"grid", " ", "=", " ", 
       RowBox[{"qcl", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"predicted", " ", "=", " ", 
       RowBox[{"predictQCLFromFTIR", "[", 
        RowBox[{"ftir", ",", " ", "grid", ",", " ", 
         RowBox[{"pv", "[", 
          RowBox[{
          "spectralModelParameters", ",", 
           " ", "\"\<QCL_LinewidthFWHM_cm1\>\""}], "]"}]}], "]"}]}], ";", 
      "\n", 
      RowBox[{"residual", " ", "=", " ", 
       RowBox[{"spectralResiduals", "[", 
        RowBox[{"predicted", ",", " ", "qcl"}], "]"}]}], ";", "\n", 
      RowBox[{"metrics", " ", "=", " ", 
       RowBox[{"spectralMetrics", "[", 
        RowBox[{"predicted", ",", " ", "qcl"}], "]"}]}], ";", "\n", 
      RowBox[{"centers", " ", "=", " ", 
       RowBox[{"pv", "[", 
        RowBox[{
        "polystyreneParameters", ",", 
         " ", "\"\<ReferencePeakCenters_cm1\>\""}], "]"}]}], ";", "\n", 
      RowBox[{"halfWindow", " ", "=", " ", 
       RowBox[{"pv", "[", 
        RowBox[{
        "calibrationParameters", ",", 
         " ", "\"\<PeakWindowHalfWidth_cm1\>\""}], "]"}]}], ";", "\n", 
      RowBox[{"ftirFits", " ", "=", " ", 
       RowBox[{"fitPeakList", "[", 
        RowBox[{
        "ftir", ",", " ", "centers", ",", " ", "halfWindow", ",", " ", "1"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"qclFits", " ", "=", " ", 
       RowBox[{"fitPeakList", "[", 
        RowBox[{
        "qcl", ",", " ", "centers", ",", " ", "halfWindow", ",", " ", "1"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<PredictedSpectrum\>\"", " ", "->", " ", "predicted"}], ",",
         "\n", 
        RowBox[{"\"\<ResidualSpectrum\>\"", " ", "->", " ", "residual"}], ",",
         "\n", 
        RowBox[{"\"\<Metrics\>\"", " ", "->", " ", "metrics"}], ",", "\n", 
        RowBox[{"\"\<PeakComparison\>\"", " ", "->", " ", 
         RowBox[{"peakComparison", "[", 
          RowBox[{"ftirFits", ",", " ", "qclFits"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<OverlayPlot\>\"", " ", "->", " ", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ftir", ",", " ", "qcl", ",", " ", "predicted"}], "}"}], ",",
            " ", 
           RowBox[{"PlotLegends", " ", "->", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<FTIR\>\"", ",", " ", "\"\<QCL measured\>\"", ",", 
              " ", "\"\<QCL predicted\>\""}], "}"}]}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
           RowBox[{"FrameLabel", " ", "->", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Wavenumber (cm^-1)\>\"", ",", 
              " ", "\"\<Absorbance\>\""}], "}"}]}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]}]}], "\n", 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"If", "[", "\n", 
  RowBox[{
   RowBox[{"readyQ", "[", 
    RowBox[{
     RowBox[{"pv", "[", 
      RowBox[{"dataFiles", ",", " ", "\"\<Polystyrene_FTIR\>\""}], "]"}], ",",
      " ", 
     RowBox[{"pv", "[", 
      RowBox[{"dataFiles", ",", " ", "\"\<Polystyrene_QCL\>\""}], "]"}], ",", 
     " ", 
     RowBox[{"pv", "[", 
      RowBox[{
      "spectralModelParameters", ",", " ", "\"\<QCL_LinewidthFWHM_cm1\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"pv", "[", 
      RowBox[{
      "polystyreneParameters", ",", " ", "\"\<ReferencePeakCenters_cm1\>\""}],
       "]"}], ",", " ", 
     RowBox[{"pv", "[", 
      RowBox[{
      "calibrationParameters", ",", " ", "\"\<PeakWindowHalfWidth_cm1\>\""}], 
      "]"}]}], "]"}], ",", "\n", "polystyreneRun", ",", "\n", 
   RowBox[{"displayValue", "[", "valueRequired", "]"}]}], "\n", 
  "]"}]}], "Input",
