       ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"lockinParameters", ",", " ", "\"\<QCLTuningDelay_s\>\""}], 
        "]"}], ",", " ", 
       RowBox[{"pv", "[", 
