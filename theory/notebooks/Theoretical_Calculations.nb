Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"importNumericCSV", "[", 
    RowBox[{"path_String", ",", " ", "nColumns_Integer"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"raw", ",", " ", "body"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"raw", " ", "=", " ", 
       RowBox[{"Import", "[", 
        RowBox[{"path", ",", " ", "\"\<CSV\>\""}], "]"}]}], ";", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"raw", " ", "===", " ", "$Failed"}], " ", "||", " ", 
         RowBox[{
          RowBox[{"Length", "[", "raw", "]"}], " ", "<", " ", "2"}]}], ",", 
        " ", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", "\n", 
      RowBox[{"body", " ", "=", " ", 
       RowBox[{"Rest", "[", "raw", "]"}]}], ";", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"And", " ", "@@", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"VectorQ", "[", 
               RowBox[{"#", ",", " ", "NumericQ"}], "]"}], " ", "&"}], " ", "/@",
              " ", "body"}], ")"}]}]}], " ", "||", " ", 
         RowBox[{"!", 
          RowBox[{"And", " ", "@@", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", 
               "nColumns"}], " ", "&"}], " ", "/@", " ", "body"}], 
            ")"}]}]}]}], ",", " ", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", "\n", 
      RowBox[{"N", "[", "body", "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"importSpectrumCSV", "[", "path_String", "]"}], " ", ":=", " ", 
   RowBox[{"SortBy", "[", 
    RowBox[{
     RowBox[{"importNumericCSV", "[", 
      RowBox[{"path", ",", " ", "2"}], "]"}], ",", " ", "First"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"importCalibrationCSV", "[", "path_String", "]"}], " ", ":=", " ", 
   RowBox[{"importNumericCSV", "[", 
    RowBox[{"path", ",", " ", "5"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"importTransientCSV", "[", "path_String", "]"}], " ", ":=", " ", 
   RowBox[{"SortBy", "[", 
    RowBox[{
     RowBox[{"importNumericCSV", "[", 
      RowBox[{"path", ",", " ", "2"}], "]"}], ",", " ", "First"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"importDualDetectorCSV", "[", "path_String", "]"}], " ", ":=", " ", 
   RowBox[{"SortBy", "[", 
    RowBox[{
     RowBox[{"importNumericCSV", "[", 
      RowBox[{"path", ",", " ", "4"}], "]"}], ",", " ", "First"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{3.9959884949907093`*^9},
 CellLabel->"In[16]:=",ExpressionUUID->"7a848d54-e206-5d41-8fae-0e109392ff6a"],

