Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hrpPopulationFunctions", "[", 
    RowBox[{
    "f0_", ",", " ", "kGem_", ",", " ", "kEscape_", ",", " ", "kOn_", ",", 
     " ", "coConcentration_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "kPocket", ",", " ", "kAssociation", ",", " ", "pocket", ",", " ", 
       "solvent"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"kPocket", " ", "=", " ", 
       RowBox[{"kGem", " ", "+", " ", "kEscape"}]}], ";", "\n", 
      RowBox[{"kAssociation", " ", "=", " ", 
       RowBox[{"kOn", "*", "coConcentration"}]}], ";", "\n", 
      RowBox[{"pocket", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", "time", "}"}], ",", " ", 
         RowBox[{"f0", "*", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "kPocket"}], "*", "time"}], "]"}]}]}], "]"}]}], ";", 
      "\n", 
      RowBox[{"solvent", " ", "=", " ", 
       RowBox[{"If", "[", "\n", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"kAssociation", " ", "-", " ", "kPocket"}], "]"}], " ", "<",
           " ", 
          RowBox[{
           RowBox[{"10", "^", 
            RowBox[{"-", "12"}]}], "*", 
           RowBox[{"Max", "[", 
            RowBox[{"1.", ",", " ", 
             RowBox[{"Abs", "[", "kAssociation", "]"}], ",", " ", 
             RowBox[{"Abs", "[", "kPocket", "]"}]}], "]"}]}]}], ",", "\n", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", "time", "}"}], ",", " ", 
           RowBox[{"f0", "*", "kEscape", "*", "time", "*", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "kPocket"}], "*", "time"}], "]"}]}]}], "]"}], ",", 
         "\n", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", "time", "}"}], ",", " ", 
           RowBox[{"f0", "*", "kEscape", "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "kPocket"}], "*", "time"}], "]"}], " ", "-", 
               " ", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "kAssociation"}], "*", "time"}], "]"}]}], ")"}],
              "/", 
             RowBox[{"(", 
              RowBox[{"kAssociation", " ", "-", " ", "kPocket"}], ")"}]}]}]}],
           "]"}]}], "\n", "]"}]}], ";", "\n", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Pocket\>\"", " ", "->", " ", "pocket"}], ",", " ", 
        RowBox[{"\"\<Solvent\>\"", " ", "->", " ", "solvent"}], ",", " ", 
        RowBox[{"\"\<Unbound\>\"", " ", "->", " ", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", "time", "}"}], ",", " ", 
           RowBox[{
            RowBox[{"pocket", "[", "time", "]"}], " ", "+", " ", 
            RowBox[{"solvent", "[", "time", "]"}]}]}], "]"}]}]}], "|>"}]}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hrpBoundEpsilon", "[", 
    RowBox[{"nu_", ",", " ", "populations_Association"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{
    RowBox[{
     RowBox[{"populations", "[", "\"\<f1905\>\"", "]"}], "*", 
     RowBox[{"pv", "[", 
      RowBox[{"hrpParameters", ",", " ", "\"\<PeakEpsilon1905_L_mol_cm\>\""}],
       "]"}], "*", 
     RowBox[{"gaussianLine", "[", 
      RowBox[{"nu", ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"hrpParameters", ",", " ", "\"\<BandCenter1905_cm1\>\""}], 
        "]"}], ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"hrpParameters", ",", " ", "\"\<BandFWHM1905_cm1\>\""}], 
        "]"}]}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"populations", "[", "\"\<f1934\>\"", "]"}], "*", 
     RowBox[{"pv", "[", 
      RowBox[{"hrpParameters", ",", " ", "\"\<PeakEpsilon1934_L_mol_cm\>\""}],
       "]"}], "*", 
     RowBox[{"gaussianLine", "[", 
      RowBox[{"nu", ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"hrpParameters", ",", " ", "\"\<BandCenter1934_cm1\>\""}], 
        "]"}], ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"hrpParameters", ",", " ", "\"\<BandFWHM1934_cm1\>\""}], 
        "]"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hrpDeltaAbsorbance", "[", 
    RowBox[{
    "nu_", ",", " ", "time_", ",", " ", "populationFunctions_", ",", " ", 
     "conformerPopulations_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      RowBox[{"populationFunctions", "[", "\"\<Unbound\>\"", "]"}], "[", 
      "time", "]"}]}], "*", 
    RowBox[{"pv", "[", 
     RowBox[{"hrpParameters", ",", " ", "\"\<ProteinConcentration_M\>\""}], 
     "]"}], "*", 
    RowBox[{"pv", "[", 
     RowBox[{"hrpParameters", ",", " ", "\"\<PathLength_cm\>\""}], "]"}], "*", 
    RowBox[{"hrpBoundEpsilon", "[", 
     RowBox[{"nu", ",", " ", "conformerPopulations"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hrpUnboundClosedForm", "[", 
    RowBox[{
    "time_", ",", " ", "kGem_", ",", " ", "kEscape_", ",", " ", "kOn_", ",", 
     " ", "coConcentration_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"kPocket", ",", " ", "kAssociation"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"kPocket", " ", "=", " ", 
       RowBox[{"kGem", " ", "+", " ", "kEscape"}]}], ";", "\n", 
      RowBox[{"kAssociation", " ", "=", " ", 
       RowBox[{"kOn", "*", "coConcentration"}]}], ";", "\n", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "kPocket"}], "*", "time"}], "]"}], " ", "+", " ", 
       RowBox[{"kEscape", "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "kPocket"}], "*", "time"}], "]"}], " ", "-", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "kAssociation"}], "*", "time"}], "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"kAssociation", " ", "-", " ", "kPocket"}], ")"}]}]}]}]}]}],
     "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fitHRPSolventTransient", "[", 
    RowBox[{"transientData_", ",", " ", "coConcentration_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"NonlinearModelFit", "[", "\n", 
    RowBox[{"transientData", ",", "\n", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"offset", " ", "+", " ", 
        RowBox[{"amplitude", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "kOn"}], "*", "coConcentration", "*", "time"}], 
          "]"}]}]}], ",", " ", 
       RowBox[{"kOn", " ", ">", " ", "0"}]}], "}"}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"offset", ",", " ", 
         RowBox[{
          RowBox[{"Last", "[", "transientData", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"amplitude", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", "transientData", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"Last", "[", "transientData", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"kOn", ",", " ", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Median", "[", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"transientData", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
               RowBox[{
                RowBox[{"#", " ", ">", " ", "0"}], " ", "&"}]}], "]"}], "]"}],
             "*", "coConcentration"}], ")"}]}]}], "}"}]}], "}"}], ",", "\n", 
     "time"}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fitHRPPocketSolventTransient", "[", 
    RowBox[{
    "transientData_", ",", " ", "coConcentration_", ",", " ", "initialKgem_", 
     ",", " ", "initialKescape_", ",", " ", "initialKon_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"NonlinearModelFit", "[", "\n", 
    RowBox[{"transientData", ",", "\n", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"offset", " ", "+", " ", 
        RowBox[{"amplitude", "*", 
         RowBox[{"hrpUnboundClosedForm", "[", 
          RowBox[{
          "time", ",", " ", "kGem", ",", " ", "kEscape", ",", " ", "kOn", ",",
            " ", "coConcentration"}], "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"kGem", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"kEscape", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"kOn", " ", ">", " ", "0"}]}]}], "}"}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"offset", ",", " ", 
         RowBox[{
          RowBox[{"Last", "[", "transientData", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"amplitude", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", "transientData", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"Last", "[", "transientData", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"kGem", ",", " ", "initialKgem"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"kEscape", ",", " ", "initialKescape"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"kOn", ",", " ", "initialKon"}], "}"}]}], "}"}], ",", "\n", 
     "time"}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hrpKineticModelComparison", "[", "transientData_", "]"}], " ", ":=",
    " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"co", ",", " ", "solventFit", ",", " ", "fullFit"}], "}"}], ",",
      "\n", 
     RowBox[{
      RowBox[{"co", " ", "=", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"hrpParameters", ",", " ", "\"\<COConcentration_M\>\""}], 
        "]"}]}], ";", "\n", 
      RowBox[{"solventFit", " ", "=", " ", 
       RowBox[{"fitHRPSolventTransient", "[", 
