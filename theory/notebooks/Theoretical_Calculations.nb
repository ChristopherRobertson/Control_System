        "]"}]}], "}"}], ",", "\n", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"order", ",", " ", "tau", ",", " ", "available"}], "}"}], ",",
        "\n", 
       RowBox[{
        RowBox[{"order", " ", "=", " ", 
         RowBox[{"Round", "[", 
          RowBox[{"pv", "[", 
           RowBox[{"lockinParameters", ",", " ", "\"\<FilterOrder\>\""}], 
           "]"}], "]"}]}], ";", "\n", 
        RowBox[{"tau", " ", "=", " ", 
         RowBox[{"pv", "[", 
          RowBox[{"lockinParameters", ",", " ", "\"\<TimeConstant_s\>\""}], 
          "]"}]}], ";", "\n", 
        RowBox[{"available", " ", "=", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"0.", ",", " ", 
           RowBox[{
            RowBox[{"pv", "[", 
             RowBox[{"lockinParameters", ",", " ", "\"\<DwellTime_s\>\""}], 
             "]"}], " ", "-", " ", 
            RowBox[{"pv", "[", 
             RowBox[{
             "lockinParameters", ",", " ", "\"\<QCLTuningDelay_s\>\""}], 
             "]"}]}]}], "]"}]}], ";", "\n", 
        RowBox[{"<|", "\n", 
         RowBox[{
          
          RowBox[{"\"\<StableMeasurementTime_s\>\"", " ", "->", " ", 
           "available"}], ",", "\n", 
          RowBox[{"\"\<SettledFraction\>\"", " ", "->", " ", 
           RowBox[{"lockinStepResponse", "[", 
            RowBox[{"available", ",", " ", "tau", ",", " ", "order"}], 
            "]"}]}], ",", "\n", 
          RowBox[{"\"\<SettlingErrorFraction\>\"", " ", "->", " ", 
