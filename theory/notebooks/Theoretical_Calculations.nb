Cell[CellGroupData[{

Cell["16. Mb\[Dash]CO Kinetic Model A: Single-Exponential Recovery", "Section",ExpressionUUID->"570fe5a6-5548-994e-85ba-73a90e824cd4"],

Cell["\<\
This section provides an empirical single-exponential description of \
Mb\[Dash]CO recovery when the measured delay range does not resolve a \
separate geminate component or when one apparent recovery time adequately \
describes the data. Required inputs are the measured Mb\[Dash]CO transient \
and, for conversion of the population decay into a spectral prediction, the \
independently entered initial photolyzed fraction, fitted A-state \
populations, Mb concentration, path length, and bound-band parameters. The \
unbound fraction is represented as f0 exp(\[Minus]t/\[Tau]single), and \
multiplication by the conformer-weighted bound-state absorptivity gives the \
time-dependent negative difference absorbance. Nonlinear regression of an \
offset plus a decaying amplitude yields the apparent time constant together \
with the offset, amplitude, fit object, parameter statistics, and residual \
information; the first and last transient values and the median positive \
delay provide the numerical starting estimates. The fitted time constant \
supplies a compact recovery metric and a reference model for comparison with \
the two-branch description, but it is not written automatically into the \
parameter association; the repeated-pulse calculation uses the corresponding \
independently entered single-exponential time. Because the model is \
empirical, it does not by itself identify a microscopic rebinding pathway, \
and its interpretation depends on a physically admissible time constant, an \
adequately sampled recovery window, structureless residuals, and the absence \
of an unresolved component large enough to bias the apparent decay.\
\>", "Text",ExpressionUUID->"425a8966-8bce-4147-9b30-617557890ef8"],

Cell[BoxData[
 RowBox[{"unboundSingle", "[", "t", "]", " ", "==", " ", "f0", "*", "Exp", "[", 
  RowBox[{"-", "t", "/", "tauSingle"}], "]"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"fafe0d13-a246-5844-adee-49bfdfa0de3b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mbSingleUnboundFraction", "[", 
    RowBox[{"t_", ",", " ", "f0_", ",", " ", "tauSingleS_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"f0", "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "t"}], "/", "tauSingleS"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mbSingleDeltaAbsorbance", "[", 
    RowBox[{
    "nu_", ",", " ", "t_", ",", " ", "f0_", ",", " ", "tauSingleS_", ",", " ",
      "populations_List"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"mbSingleUnboundFraction", "[", 
      RowBox[{"t", ",", " ", "f0", ",", " ", "tauSingleS"}], "]"}]}], "*", 
    RowBox[{"pv", "[", 
     RowBox[{"mbParameters", ",", " ", "\"\<ProteinConcentration_M\>\""}], 
     "]"}], "*", 
    RowBox[{"pv", "[", 
     RowBox[{"mbParameters", ",", " ", "\"\<PathLength_cm\>\""}], "]"}], "*", 
    RowBox[{"mbBoundEpsilon", "[", 
     RowBox[{"nu", ",", " ", "populations"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fitSingleExponentialTransient", "[", "transientData_", "]"}], " ",
    ":=", " ", 
   RowBox[{"NonlinearModelFit", "[", "\n", 
    RowBox[{"transientData", ",", "\n", 
     RowBox[{"offset", " ", "+", " ", 
      RowBox[{"amplitude", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "time"}], "/", "tau"}], "]"}]}]}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"offset", ",", " ", 
         RowBox[{
          RowBox[{"Last", "[", "transientData", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"amplitude", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", "transientData", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"Last", "[", "transientData", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"tau", ",", " ", 
         RowBox[{"Median", "[", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"transientData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"#", " ", ">", " ", "0"}], " ", "&"}]}], "]"}], "]"}]}], 
        "}"}]}], "}"}], ",", "\n", "time"}], "\n", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.995988495186535*^9},
 CellLabel->
