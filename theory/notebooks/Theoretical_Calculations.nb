Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"monteCarloSample", "[", 
    RowBox[{
    "distributionAssociation_Association", ",", " ", "sampleCount_Integer"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"keys", ",", " ", "draws"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"keys", " ", "=", " ", 
       RowBox[{"Keys", "[", "distributionAssociation", "]"}]}], ";", "\n", 
      RowBox[{"draws", " ", "=", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomVariate", "[", 
           RowBox[{
            RowBox[{"distributionAssociation", "[", "#", "]"}], ",", " ", 
            "sampleCount"}], "]"}], " ", "&"}], " ", "/@", " ", "keys"}], 
        "]"}]}], ";", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{"AssociationThread", "[", 
         RowBox[{"keys", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
       "draws"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"monteCarloEvaluate", "[", 
    RowBox[{
    "modelFunction_", ",", " ", "distributionAssociation_Association", ",", 
     " ", "sampleCount_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"modelFunction", " ", "/@", " ", 
    RowBox[{"monteCarloSample", "[", 
     RowBox[{"distributionAssociation", ",", " ", "sampleCount"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"predictionInterval", "[", "values_List", "]"}], " ", ":=", " ", 
   RowBox[{"<|", "\n", 
    RowBox[{
     RowBox[{"\"\<Median\>\"", " ", "->", " ", 
      RowBox[{"Median", "[", "values", "]"}]}], ",", "\n", 
     RowBox[{"\"\<Lower95\>\"", " ", "->", " ", 
      RowBox[{"Quantile", "[", 
       RowBox[{"values", ",", " ", "0.025"}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<Upper95\>\"", " ", "->", " ", 
      RowBox[{"Quantile", "[", 
       RowBox[{"values", ",", " ", "0.975"}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<Mean\>\"", " ", "->", " ", 
      RowBox[{"Mean", "[", "values", "]"}]}], ",", "\n", 
     RowBox[{"\"\<StandardDeviation\>\"", " ", "->", " ", 
      RowBox[{"StandardDeviation", "[", "values", "]"}]}]}], "\n", "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"monteCarloSummary", "[", "associationResults_List", "]"}], " ", ":=",
    " ", 
   RowBox[{"Map", "[", 
    RowBox[{"predictionInterval", ",", " ", 
     RowBox[{"Merge", "[", 
      RowBox[{"associationResults", ",", " ", "Identity"}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{3.9959884952929344`*^9},
 CellLabel->
  "In[171]:=",ExpressionUUID->"3f04b956-32a7-784e-b03b-534ad8b18bd2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"supplementUncertaintyModel", "[", "input_Association", "]"}], " ",
    ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "initialAbsorbance", ",", " ", "fPhoto", ",", " ", "qclSigma", ",", " ",
        "effectiveSpectralSigma", ",", " ", "temporalSigma"}], "}"}], ",", 
     "\n", 
     RowBox[{
      RowBox[{"initialAbsorbance", " ", "=", " ", 
       RowBox[{
        RowBox[{"input", "[", "\"\<PeakEpsilon_L_mol_cm\>\"", "]"}], "*", 
        RowBox[{"input", "[", "\"\<Concentration_M\>\"", "]"}], "*", 
        RowBox[{"input", "[", "\"\<PathLength_cm\>\"", "]"}]}]}], ";", "\n", 
      RowBox[{"fPhoto", " ", "=", " ", 
       RowBox[{"photolyzedFraction", "[", "\n", 
        RowBox[{
         RowBox[{"input", "[", "\"\<PumpPulseEnergy_J\>\"", "]"}], ",", " ", 
         RowBox[{"input", "[", "\"\<PumpWavelength_nm\>\"", "]"}], ",", " ", 
         RowBox[{"input", "[", "\"\<PumpAbsorbance\>\"", "]"}], ",", "\n", 
         RowBox[{"input", "[", "\"\<PumpProbeOverlapFraction\>\"", "]"}], ",",
          " ", 
         RowBox[{"input", "[", "\"\<PhotolysisQuantumYield\>\"", "]"}], ",", 
         " ", 
         RowBox[{"input", "[", "\"\<Concentration_M\>\"", "]"}], ",", "\n", 
         RowBox[{"input", "[", "\"\<OverlapArea_m2\>\"", "]"}], ",", " ", 
         RowBox[{"input", "[", "\"\<PathLength_cm\>\"", "]"}]}], "\n", 
        "]"}]}], ";", "\n", 
      RowBox[{"qclSigma", " ", "=", " ", 
       RowBox[{
        RowBox[{"input", "[", "\"\<QCLLinewidth_cm1\>\"", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "*", 
            RowBox[{"Log", "[", "2", "]"}]}], "]"}]}], ")"}]}]}], ";", "\n", 
      RowBox[{"effectiveSpectralSigma", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"input", "[", "\"\<SamplePeakSigma_cm1\>\"", "]"}], "^", 
          "2"}], " ", "+", " ", 
         RowBox[{"qclSigma", "^", "2"}], " ", "+", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"input", "[", "\"\<QCLStep_cm1\>\"", "]"}], "^", "2"}], "/",
           "12"}]}], "]"}]}], ";", "\n", 
      RowBox[{"temporalSigma", " ", "=", " ", 
       RowBox[{"Sqrt", "[", "\n", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"input", "[", "\"\<PumpFWHM_s\>\"", "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", "*", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"2", "*", 
                RowBox[{"Log", "[", "2", "]"}]}], "]"}]}], ")"}]}], ")"}], "^",
           "2"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"input", "[", "\"\<TimingJitter_s\>\"", "]"}], "^", "2"}], 
         " ", "+", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"input", "[", "\"\<ProbeWidth_s\>\"", "]"}], "^", "2"}], "/",
           "12"}], " ", "+", "\n", 
         RowBox[{
          RowBox[{"input", "[", "\"\<DetectorTimeConstant_s\>\"", "]"}], "^", 
          "2"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"Round", "[", 
           RowBox[{"input", "[", "\"\<LockinOrder\>\"", "]"}], "]"}], "*", 
          RowBox[{
           RowBox[{"input", "[", "\"\<LockinTimeConstant_s\>\"", "]"}], "^", 
           "2"}]}]}], "\n", "]"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<PeakPosition_cm1\>\"", " ", "->", " ", 
         RowBox[{
          RowBox[{"input", "[", "\"\<TruePeakCenter_cm1\>\"", "]"}], " ", "+",
           " ", 
          RowBox[{"input", "[", "\"\<CalibrationOffset_cm1\>\"", "]"}]}]}], ",",
         "\n", 
        RowBox[{"\"\<EffectiveFWHM_cm1\>\"", " ", "->", " ", 
         RowBox[{"2", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "*", 
            RowBox[{"Log", "[", "2", "]"}]}], "]"}], "*", 
          "effectiveSpectralSigma"}]}], ",", "\n", 
        RowBox[{"\"\<DarkAbsorbance\>\"", " ", "->", " ", 
         "initialAbsorbance"}], ",", "\n", 
        RowBox[{"\"\<InitialTransientAmplitudeMagnitude\>\"", " ", "->", " ", 
         RowBox[{"fPhoto", "*", "initialAbsorbance"}]}], ",", "\n", 
        RowBox[{"\"\<NoiseEquivalentAbsorbance\>\"", " ", "->", " ", 
         RowBox[{"input", "[", "\"\<AbsorbanceNoise\>\"", "]"}]}], ",", "\n", 
        RowBox[{"\"\<GaussianEquivalentTemporalFWHM_s\>\"", " ", "->", " ", 
         RowBox[{"2", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "*", 
            RowBox[{"Log", "[", "2", "]"}]}], "]"}], "*", 
          "temporalSigma"}]}]}], "\n", "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"monteCarloRun", "[", 
    RowBox[{"sampleCount_Integer", ":", " ", "10000"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"distributions", ",", " ", "results"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"distributions", " ", "=", " ", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"pv", "[", 
           RowBox[{"monteCarloDistributions", ",", " ", "#"}], "]"}], " ", 
          "&"}], ",", " ", 
         RowBox[{"Keys", "[", "monteCarloDistributions", "]"}]}], "]"}]}], ";",
       "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"distributions", ",", " ", "_Missing"}], "]"}]}], ",", " ", 
        RowBox[{"Return", "[", 
         RowBox[{"displayValue", "[", "valueRequired", "]"}], "]"}]}], "]"}], 
      ";", "\n", 
      RowBox[{"results", " ", "=", " ", 
       RowBox[{"monteCarloEvaluate", "[", 
        RowBox[{
        "supplementUncertaintyModel", ",", " ", "distributions", ",", " ", 
         "sampleCount"}], "]"}]}], ";", "\n", 
      RowBox[{"monteCarloSummary", "[", "results", "]"}]}]}], "\n", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{3.9959884952999344`*^9},
 CellLabel->
  "In[175]:=",ExpressionUUID->"f3f34554-f4e6-0f44-85e2-6d7d492b559d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["25. Predicted-versus-Measured Comparison Tables", "Section",ExpressionUUID->"55af18f8-29c4-3d4e-8245-615a79af8bb8"],

Cell["\<\
This section consolidates model predictions and experimental results for the \
reported calibration, spectral, kinetic, noise, and temporal-response \
quantities. Each row uses a quantity label, predicted central value, lower \
and upper 95% prediction limits, measured value, and unit, and the \
calculation appends the residual defined as measured minus predicted. All \
predicted, interval, and measured fields are supplied independently; the \
table does not import upstream notebook results automatically. The resulting \
rows cover polystyrene wavenumber error and linewidth, Mylar spectral \
residual, HRP\[Dash]CO and Mb\[Dash]CO amplitudes and kinetic parameters, \
noise-equivalent absorbance, and temporal instrument-response FWHM, providing \
a uniform record of agreement and discrepancy between forward predictions and \
measurements. Predicted and measured entries are compared only after their \
definitions, conditions, and units have been matched, and an unresolved value \
remains explicitly unreported rather than being inferred. The present routine \
does not calculate a normalized residual; statistical interpretation \
therefore relies on the displayed 95% prediction interval unless a separately \
defined, nonzero combined uncertainty is introduced.\
\>", "Text",ExpressionUUID->"a13208fa-9ad7-5346-b453-408361cc8ef6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"comparisonRow", "[", 
    RowBox[{
    "quantity_", ",", " ", "predicted_", ",", " ", "lower95_", ",", " ", 
     "upper95_", ",", " ", "measured_", ",", " ", "unit_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"<|", "\n", 
    RowBox[{
     RowBox[{"\"\<Quantity\>\"", " ", "->", " ", "quantity"}], ",", "\n", 
     RowBox[{"\"\<Predicted\>\"", " ", "->", " ", "predicted"}], ",", "\n", 
     RowBox[{"\"\<Lower95\>\"", " ", "->", " ", "lower95"}], ",", "\n", 
     RowBox[{"\"\<Upper95\>\"", " ", "->", " ", "upper95"}], ",", "\n", 
     RowBox[{"\"\<Measured\>\"", " ", "->", " ", "measured"}], ",", "\n", 
     RowBox[{"\"\<Residual_MeasuredMinusPredicted\>\"", " ", "->", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"readyQ", "[", 
         RowBox[{"predicted", ",", " ", "measured"}], "]"}], ",", " ", 
        RowBox[{"measured", " ", "-", " ", "predicted"}], ",", " ", 
        "valueRequired"}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<Unit\>\"", " ", "->", " ", "unit"}]}], "\n", "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"comparisonTable", " ", "=", " ", 
   RowBox[{"{", "\n", 
    RowBox[{
     RowBox[{"comparisonRow", "[", 
      RowBox[{"\"\<Polystyrene RMS wavenumber error\>\"", ",", " ", 
       "valueRequired", ",", " ", "valueRequired", ",", " ", "valueRequired", 
       ",", " ", "valueRequired", ",", " ", "\"\<cm^-1\>\""}], "]"}], ",", 
     "\n", 
     RowBox[{"comparisonRow", "[", 
      RowBox[{"\"\<Polystyrene representative FWHM\>\"", ",", " ", 
       "valueRequired", ",", " ", "valueRequired", ",", " ", "valueRequired", 
       ",", " ", "valueRequired", ",", " ", "\"\<cm^-1\>\""}], "]"}], ",", 
     "\n", 
     RowBox[{"comparisonRow", "[", 
      RowBox[{"\"\<Mylar RMS spectral residual\>\"", ",", " ", 
       "valueRequired", ",", " ", "valueRequired", ",", " ", "valueRequired", 
       ",", " ", "valueRequired", ",", " ", "\"\<absorbance\>\""}], "]"}], ",",
      "\n", 
     RowBox[{"comparisonRow", "[", 
      RowBox[{"\"\<HRP-CO initial bleach\>\"", ",", " ", "valueRequired", ",",
        " ", "valueRequired", ",", " ", "valueRequired", ",", " ", 
       "valueRequired", ",", " ", "\"\<absorbance\>\""}], "]"}], ",", "\n", 
     RowBox[{"comparisonRow", "[", 
      RowBox[{"\"\<HRP-CO recovery time\>\"", ",", " ", "valueRequired", ",", 
       " ", "valueRequired", ",", " ", "valueRequired", ",", " ", 
       "valueRequired", ",", " ", "\"\<s\>\""}], "]"}], ",", "\n", 
     RowBox[{"comparisonRow", "[", 
      RowBox[{"\"\<Mb-CO initial bleach\>\"", ",", " ", "valueRequired", ",", 
       " ", "valueRequired", ",", " ", "valueRequired", ",", " ", 
       "valueRequired", ",", " ", "\"\<absorbance\>\""}], "]"}], ",", "\n", 
     RowBox[{"comparisonRow", "[", 
      RowBox[{"\"\<Mb-CO geminate time\>\"", ",", " ", "valueRequired", ",", 
       " ", "valueRequired", ",", " ", "valueRequired", ",", " ", 
       "valueRequired", ",", " ", "\"\<s\>\""}], "]"}], ",", "\n", 
     RowBox[{"comparisonRow", "[", 
      RowBox[{"\"\<Mb-CO bimolecular rate\>\"", ",", " ", "valueRequired", ",",
        " ", "valueRequired", ",", " ", "valueRequired", ",", " ", 
       "valueRequired", ",", " ", "\"\<L mol^-1 s^-1\>\""}], "]"}], ",", "\n", 
     RowBox[{"comparisonRow", "[", 
      RowBox[{"\"\<Noise-equivalent absorbance\>\"", ",", " ", 
       "valueRequired", ",", " ", "valueRequired", ",", " ", "valueRequired", 
       ",", " ", "valueRequired", ",", " ", "\"\<absorbance Hz^-1/2\>\""}], 
      "]"}], ",", "\n", 
     RowBox[{"comparisonRow", "[", 
      RowBox[{"\"\<Temporal instrument-response FWHM\>\"", ",", " ", 
       "valueRequired", ",", " ", "valueRequired", ",", " ", "valueRequired", 
       ",", " ", "valueRequired", ",", " ", "\"\<s\>\""}], "]"}]}], "\n", 
    "}"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", "comparisonTable", "]"}]}], "Input",
 CellChangeTimes->{3.995988495308607*^9},
 CellLabel->
  "In[177]:=",ExpressionUUID->"81b30cb8-2489-e44a-b3ba-6becb5f60e09"],

