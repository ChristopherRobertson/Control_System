Cell[CellGroupData[{

Cell["2. Required CSV Data Layouts", "Section",ExpressionUUID->"f2886b72-27d9-1345-9853-d42f071adce5"],

Cell["\<\
This section defines the sole data interface used by the calculations. The \
required inputs are the paths to the preprocessed FTIR and QCL spectra, \
calibration-peak table, HRP\[Dash]CO and Mb\[Dash]CO pump\[Dash]probe \
transients, dual-detector trace, and fixed-wavenumber baseline trace. Each \
CSV file contains one header row followed by numeric records in the specified \
column order. The import functions remove the header, verify that every data \
row is numeric and has the required number of columns, convert the records to \
numerical form, and sort spectra, transients, and detector traces by their \
first coordinate. Wavenumbers are expressed in cm^-1, times and delays in \
seconds, absorbance as base-10 absorbance, and detector signals in volts; \
direction codes of +1 and \[Minus]1 denote increasing and decreasing \
wavenumber, respectively, while state codes of 0 and 1 denote background and \
sample measurements. These fixed schemas produce unambiguous arrays for \
downstream calculations and prevent silent column inference or format \
substitution. Because column meaning is positional, the listed header order \
remains part of the dataset provenance even though the import routine \
validates row width and numeric content rather than matching the header text \
itself.\
\>", "Text",ExpressionUUID->"82025d9b-c1c0-f94c-9894-4c101ec2c3d5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"csvLayouts", " ", "=", " ", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", "\n", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<Dataset\>\"", ",", 
         " ", "\"\<Required header in exact column order\>\""}], "}"}], ",", 
       "\n", 
       RowBox[{"{", 
        RowBox[{"\"\<Spectrum\>\"", ",", 
         " ", "\"\<Wavenumber_cm-1,Absorbance\>\""}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"\"\<Calibration peaks\>\"", ",", 
         " ", "\"\<Reference_cm-1,QCLPeak_cm-1,DirectionCode,ElapsedTime_s,\
ReplicateID\>\""}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"\"\<Pump-probe transient\>\"", ",", 
         " ", "\"\<Delay_s,DeltaAbsorbance\>\""}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"\"\<Dual-detector trace\>\"", ",", 
         " ", "\"\<Time_s,Sample_V,Reference_V,StateCode\>\""}], "}"}], ",", 
       "\n", 
       RowBox[{"{", 
        RowBox[{"\"\<Baseline trace\>\"", ",", 
         " ", "\"\<Time_s,Absorbance\>\""}], "}"}]}], "\n", "}"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
     RowBox[{"Background", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Lighter", "[", 
           RowBox[{"Gray", ",", " ", "0.90"}], "]"}], ",", " ", "None"}], 
         "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", "csvLayouts"}], "Input",
 CellChangeTimes->{3.99598849498518*^9},
 CellLabel->"In[14]:=",ExpressionUUID->"bb6e41c1-88d9-8e4e-8162-4ed380d453dd"],

