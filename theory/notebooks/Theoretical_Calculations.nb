Cell[CellGroupData[{

Cell["\<\
17. Mb\[Dash]CO Kinetic Model B: Geminate Plus Bimolecular Rebinding\
\>", "Section",ExpressionUUID->"4ce502a5-9f25-2943-93ea-ffe063309f39"],

Cell[TextData[{
 "This section evaluates a two-branch Mb\[Dash]CO recovery model in which one \
part of the initially photolyzed population rebinds geminately and the \
remainder escapes into a CO-dependent bimolecular pathway, consistent with \
established three-state descriptions of Mb\[Dash]CO rebinding.",
 StyleBox["8",
  FontVariations -> {"Superscript" -> True}],
 " Required inputs are the measured transient and dissolved-CO concentration; \
the separately defined population and spectral relations additionally use the \
independently entered initial photolyzed fraction and fitted spectral \
quantities needed to convert population recovery into difference absorbance. \
The unbound population is calculated as the weighted sum of a geminate \
exponential with fraction fgem and time constant \[Tau]gem and a \
solvent-rebinding exponential with rate kon[CO]. Constrained nonlinear \
regression yields the offset, amplitude, geminate fraction, geminate time \
constant, bimolecular association rate, fitted transient, and associated fit \
diagnostics; the numerical starting values of 0.04 and 180 ns are \
literature-derived guides from one room-temperature aqueous Mb\[Dash]CO study \
rather than fixed properties of the present sample.",
 StyleBox["9",
  FontVariations -> {"Superscript" -> True}],
 " The model tests whether the data support a resolvable fast branch and \
separates its fitted contribution from slower solvent recovery. Fitted \
quantities are not written automatically into the parameter association. The \
geminate fraction is constrained between zero and one and both time scales \
remain positive, while interpretation accounts for parameter correlation, the \
constant-CO approximation, the temporal instrument response, and the fact \
that literature starting values cannot substitute for an experimentally \
resolved component."
}], "Text",
 CellChangeTimes->{
  3.995988494911268*^9},ExpressionUUID->"b386ca75-a6ca-bc40-b2ea-\
cc222af099fa"],

Cell[BoxData[
 RowBox[{"unboundTwoBranch", "[", "t", "]", " ", "==", " ", "f0", "*", "(", 
  RowBox[{"fGem", "*", "Exp", "[", 
   RowBox[{"-", "t", "/", "tauGem"}], "]", " ", "+", " ", "(", 
   RowBox[{"1", " ", "-", " ", "fGem"}], ")", "*", "Exp", "[", 
   RowBox[{"-", "kOn", "*", "COconcentration", "*", "t"}], "]"}], 
  ")"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"73f8e7eb-dce2-b14d-a44d-20f74f0c84e1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mbTwoBranchUnboundFraction", "[", 
    RowBox[{
    "t_", ",", " ", "f0_", ",", " ", "geminateFraction_", ",", " ", 
     "geminateTauS_", ",", " ", "kOnM1S1_", ",", " ", "coConcentrationM_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"f0", "*", 
    RowBox[{"(", "\n", 
     RowBox[{
      RowBox[{"geminateFraction", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "t"}], "/", "geminateTauS"}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "geminateFraction"}], ")"}], "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "kOnM1S1"}], "*", "coConcentrationM", "*", "t"}], 
        "]"}]}]}], "\n", ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mbTwoBranchDeltaAbsorbance", "[", 
    RowBox[{
    "nu_", ",", " ", "t_", ",", " ", "f0_", ",", " ", "geminateFraction_", ",",
      " ", "geminateTauS_", ",", " ", "kOnM1S1_", ",", " ", 
     "coConcentrationM_", ",", " ", "populations_List"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"mbTwoBranchUnboundFraction", "[", 
      RowBox[{
      "t", ",", " ", "f0", ",", " ", "geminateFraction", ",", " ", 
       "geminateTauS", ",", " ", "kOnM1S1", ",", " ", "coConcentrationM"}], 
      "]"}]}], "*", 
    RowBox[{"pv", "[", 
     RowBox[{"mbParameters", ",", " ", "\"\<ProteinConcentration_M\>\""}], 
     "]"}], "*", 
    RowBox[{"pv", "[", 
     RowBox[{"mbParameters", ",", " ", "\"\<PathLength_cm\>\""}], "]"}], "*", 
    RowBox[{"mbBoundEpsilon", "[", 
     RowBox[{"nu", ",", " ", "populations"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fitTwoBranchTransient", "[", 
    RowBox[{"transientData_", ",", " ", "coConcentrationM_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"NonlinearModelFit", "[", "\n", 
    RowBox[{"transientData", ",", "\n", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"offset", " ", "+", " ", 
        RowBox[{"amplitude", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"geminateFraction", "*", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "time"}], "/", "tauGem"}], "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", "geminateFraction"}], ")"}], "*", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "kOn"}], "*", "coConcentrationM", "*", "time"}], 
             "]"}]}]}], ")"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{
        "0", " ", "<=", " ", "geminateFraction", " ", "<=", " ", "1"}], " ", "&&",
         " ", 
        RowBox[{"tauGem", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"kOn", " ", ">", " ", "0"}]}]}], "}"}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"offset", ",", " ", 
         RowBox[{
          RowBox[{"Last", "[", "transientData", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"amplitude", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", "transientData", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"Last", "[", "transientData", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"geminateFraction", ",", " ", "0.04"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"tauGem", ",", " ", 
         RowBox[{"180", "*", 
          RowBox[{"10", "^", 
           RowBox[{"-", "9"}]}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"kOn", ",", " ", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Median", "[", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"transientData", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
               RowBox[{
                RowBox[{"#", " ", ">", " ", "0"}], " ", "&"}]}], "]"}], "]"}],
             "*", "coConcentrationM"}], ")"}]}]}], "}"}]}], "}"}], ",", "\n", 
     "time"}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mbLiteratureGuide", " ", "=", " ", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", "\n", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<Quantity\>\"", ",", 
         " ", "\"\<Literature planning value\>\"", ",", 
         " ", "\"\<Notebook use\>\""}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"\"\<Pump wavelength\>\"", ",", 
         " ", "\"\<532 nm is established for Mb-CO photolysis\>\"", ",", 
         " ", "\"\<Experimental starting wavelength\>\""}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"\"\<Bound CO bands\>\"", ",", 
