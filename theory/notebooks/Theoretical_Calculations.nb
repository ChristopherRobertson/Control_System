Cell[CellGroupData[{

Cell["9. Polymer-Film Interference", "Section",ExpressionUUID->"62a96ce8-6e34-2c40-b037-8b2c7c7a9055"],

Cell["\<\
This section evaluates whether periodic structure in the polymer-film spectra \
or forward-model residuals is consistent with optical interference. The \
required inputs are the independently determined film thickness, refractive \
index, external incidence angle, and absorption coefficient for polystyrene \
or Mylar, together with a residual spectrum when empirical fringe metrics are \
evaluated. In the symmetric air\[Dash]film\[Dash]air \
Fabry\[Dash]P\[EAcute]rot model [CITATION NEEDED], the transmitted angle is \
calculated from Snell\[CloseCurlyQuote]s law, the predicted fringe spacing is \
1/[2nd cos(\[Theta]t)], and the transmission includes surface reflectance, \
absorption along the oblique path, phase accumulation, and multiple internal \
reflections before conversion to base-10 absorbance. For measured residuals, \
linear interpolation onto a uniform wavenumber grid and removal of a linear \
baseline precede Fourier-power analysis; the dominant nonzero frequency \
yields the observed fringe spacing, while peak-to-peak amplitude, \
root-mean-square amplitude, and quadratic baseline curvature describe \
residual magnitude and trend. The predicted polystyrene and Mylar spacings \
and the empirical residual metrics help distinguish film interference from \
calibration or spectral-response error. The current approximation treats the \
surrounding medium as air, uses a symmetric film with a scalar refractive \
index and angle-independent surface reflectance, and does not represent \
polarization dependence, refractive-index dispersion, surface roughness, or \
film wedge; these limitations are relevant when the measured fringe pattern \
departs from the ideal etalon model.\
\>", "Text",ExpressionUUID->"a7fc855e-9c42-1042-93f7-a9bb0b2d8c83"],

Cell[BoxData[
 RowBox[{"fringeSpacing", " ", "==", " ", "1", "/", "(", 
  RowBox[{"2", "*", "n", "*", "thickness", "*", "Cos", "[", "thetaT", "]"}], 
  ")"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"ff221d07-a39c-1b45-a17e-0053528c6d2b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"transmittedAngle", "[", 
    RowBox[{"incidenceAngleRad_", ",", " ", "refractiveIndex_"}], "]"}], " ", 
   ":=", " ", 
   RowBox[{"ArcSin", "[", 
    RowBox[{
     RowBox[{"Sin", "[", "incidenceAngleRad", "]"}], "/", "refractiveIndex"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fringeSpacingCm1", "[", 
    RowBox[{
    "refractiveIndex_", ",", " ", "thicknessCm_", ",", " ", 
     "incidenceAngleDeg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "thetaT", "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"thetaT", " ", "=", " ", 
       RowBox[{"transmittedAngle", "[", 
        RowBox[{
         RowBox[{"incidenceAngleDeg", "*", "Degree"}], ",", " ", 
         "refractiveIndex"}], "]"}]}], ";", "\n", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", "refractiveIndex", "*", "thicknessCm", "*", 
         RowBox[{"Cos", "[", "thetaT", "]"}]}], ")"}]}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"surfaceReflectance", "[", "refractiveIndex_", "]"}], " ", ":=", 
   " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"refractiveIndex", " ", "-", " ", "1"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"refractiveIndex", " ", "+", " ", "1"}], ")"}]}], ")"}], "^", 
    "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fabryPerotTransmission", "[", 
    RowBox[{
    "nuCm1_", ",", " ", "refractiveIndex_", ",", " ", "thicknessCm_", ",", 
     " ", "incidenceAngleDeg_", ",", " ", "alphaCm1_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", "\n", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "thetaT", ",", " ", "reflectance", ",", " ", "opticalDepth", ",", " ", 
       "phase"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"thetaT", " ", "=", " ", 
       RowBox[{"transmittedAngle", "[", 
        RowBox[{
         RowBox[{"incidenceAngleDeg", "*", "Degree"}], ",", " ", 
         "refractiveIndex"}], "]"}]}], ";", "\n", 
      RowBox[{"reflectance", " ", "=", " ", 
       RowBox[{"surfaceReflectance", "[", "refractiveIndex", "]"}]}], ";", 
      "\n", 
      RowBox[{"opticalDepth", " ", "=", " ", 
       RowBox[{"alphaCm1", "*", 
        RowBox[{"thicknessCm", "/", 
         RowBox[{"Cos", "[", "thetaT", "]"}]}]}]}], ";", "\n", 
      RowBox[{"phase", " ", "=", " ", 
       RowBox[{
       "4", "*", "Pi", "*", "refractiveIndex", "*", "thicknessCm", "*", 
        "nuCm1", "*", 
        RowBox[{"Cos", "[", "thetaT", "]"}]}]}], ";", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", "reflectance"}], ")"}], "^", "2"}], "*", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"-", "opticalDepth"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"2", "*", "reflectance", "*", 
           RowBox[{"Exp", "[", 
            RowBox[{"-", "opticalDepth"}], "]"}], "*", 
           RowBox[{"Cos", "[", "phase", "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"reflectance", "^", "2"}], "*", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "2"}], "*", "opticalDepth"}], "]"}]}]}], 
         ")"}]}]}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fabryPerotAbsorbance", "[", "args___", "]"}], " ", ":=", " ", 
   RowBox[{"-", 
    RowBox[{"Log", "[", 
     RowBox[{"10", ",", " ", 
      RowBox[{"fabryPerotTransmission", "[", "args", "]"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dominantFringeSpacing", "[", "residualSpectrum_", "]"}], " ", ":=",
    " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "x", ",", " ", "y", ",", " ", "n", ",", " ", "dx", ",", " ", "uniformX",
        ",", " ", "uniformY", ",", " ", "baseline", ",", " ", "detrended", ",",
        " ", "power", ",", " ", "indices", ",", " ", "selectedIndex", ",", 
       " ", "harmonicFrequency"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"x", " ", "=", " ", 
       RowBox[{"residualSpectrum", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"y", " ", "=", " ", 
       RowBox[{"residualSpectrum", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"n", " ", "=", " ", 
       RowBox[{"Length", "[", "x", "]"}]}], ";", "\n", 
      RowBox[{"dx", " ", "=", " ", 
       RowBox[{"Median", "[", 
        RowBox[{"Differences", "[", "x", "]"}], "]"}]}], ";", "\n", 
      RowBox[{"uniformX", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"Min", "[", "x", "]"}], ",", " ", 
         RowBox[{"Max", "[", "x", "]"}], ",", " ", "dx"}], "]"}]}], ";", "\n", 
      RowBox[{"uniformY", " ", "=", " ", 
       RowBox[{
        RowBox[{"Interpolation", "[", 
         RowBox[{"residualSpectrum", ",", " ", 
          RowBox[{"InterpolationOrder", " ", "->", " ", "1"}]}], "]"}], " ", "/@",
         " ", "uniformX"}]}], ";", "\n", 
      RowBox[{"baseline", " ", "=", " ", 
       RowBox[{"LinearModelFit", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"uniformX", ",", " ", "uniformY"}], "}"}], "]"}], ",", " ",
          "coordinate", ",", " ", "coordinate"}], "]"}]}], ";", "\n", 
      RowBox[{"detrended", " ", "=", " ", 
       RowBox[{"uniformY", " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{"baseline", " ", "/@", " ", "uniformX"}], ")"}]}]}], ";", 
      "\n", 
      RowBox[{"power", " ", "=", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Fourier", "[", "detrended", "]"}], "]"}], "^", "2"}]}], ";",
       "\n", 
      RowBox[{"indices", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"2", ",", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"Length", "[", "power", "]"}], "/", "2"}], "]"}]}], 
        "]"}]}], ";", "\n", 
      RowBox[{"selectedIndex", " ", "=", " ", 
       RowBox[{"First", "[", 
        RowBox[{"Ordering", "[", 
         RowBox[{
          RowBox[{"power", "[", 
           RowBox[{"[", "indices", " ", "]"}], "]"}], ",", " ", 
          RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"harmonicFrequency", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"indices", "[", 
           RowBox[{"[", "selectedIndex", " ", "]"}], "]"}], " ", "-", " ", 
          "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Length", "[", "uniformX", "]"}], "*", "dx"}], ")"}]}]}], ";",
       "\n", 
      RowBox[{"1", "/", "harmonicFrequency"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fringeResidualMetrics", "[", "residualSpectrum_", "]"}], " ", ":=",
    " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y", ",", " ", "quadraticFit"}], "}"}], ",", 
     "\n", 
     RowBox[{
      RowBox[{"x", " ", "=", " ", 
       RowBox[{"residualSpectrum", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"y", " ", "=", " ", 
       RowBox[{"residualSpectrum", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"quadraticFit", " ", "=", " ", 
       RowBox[{"LinearModelFit", "[", 
        RowBox[{"residualSpectrum", ",", " ", 
         RowBox[{"{", 
          RowBox[{"coordinate", ",", " ", 
           RowBox[{"coordinate", "^", "2"}]}], "}"}], ",", " ", 
         "coordinate"}], "]"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<DominantSpacing_cm1\>\"", " ", "->", " ", 
         RowBox[{"dominantFringeSpacing", "[", "residualSpectrum", "]"}]}], ",",
         "\n", 
        RowBox[{"\"\<PeakToPeakAmplitude_absorbance\>\"", " ", "->", " ", 
         RowBox[{
          RowBox[{"Max", "[", "y", "]"}], " ", "-", " ", 
          RowBox[{"Min", "[", "y", "]"}]}]}], ",", "\n", 
        RowBox[{"\"\<RMSAmplitude_absorbance\>\"", " ", "->", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Mean", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"y", " ", "-", " ", 
              RowBox[{"Mean", "[", "y", "]"}]}], ")"}], "^", "2"}], "]"}], 
          "]"}]}], ",", "\n", 
        RowBox[{"\"\<QuadraticBaselineCoefficient_absorbance_per_cm1Squared\>\
\"", " ", "->", " ", 
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"Normal", "[", "quadraticFit", "]"}], ",", " ", 
           "coordinate", ",", " ", "2"}], "]"}]}]}], "\n", "|>"}]}]}], "\n", 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.995988495072569*^9},
 CellLabel->"In[58]:=",ExpressionUUID->"995609da-469b-5b44-8de2-328b0b54183d"],

