Cell[BoxData[{
 RowBox[{
  RowBox[{"lockinSettlingSummary", " ", "=", " ", 
   RowBox[{"safeEvaluate", "[", "\n", 
    RowBox[{"\"\<Lock-in settling\>\"", ",", "\n", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"pv", "[", 
        RowBox[{"lockinParameters", ",", " ", "\"\<FilterOrder\>\""}], "]"}], 
       ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"lockinParameters", ",", " ", "\"\<TimeConstant_s\>\""}], 
