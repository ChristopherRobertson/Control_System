Cell[CellGroupData[{

Cell["5. Polystyrene Wavenumber Calibration", "Section",ExpressionUUID->"0edec359-f260-e847-be61-8767474becf1"],

Cell[TextData[{
 "This section determines the QCL wavenumber correction and characterizes \
calibration accuracy, repeatability, scan-direction dependence, and temporal \
drift from polystyrene measurements. The required input is the \
calibration-peak CSV containing the reference and observed QCL peak \
positions, scan-direction code, elapsed time, and replicate identifier, \
together with the selected polynomial order; the elapsed warm-up time, 0.5 \
cm^-1 comparison bound, and Gaussian peak-fit window document the acquisition \
context. Reference wavenumber is fitted as a linear or quadratic function of \
observed QCL wavenumber, and the fitted correction is used to calculate the \
signed residual for every calibration peak. The outputs include the \
calibration coefficients and their parameter table, mean signed error, \
root-mean-square deviation, maximum absolute error, direction-specific mean \
residuals, drift slope with elapsed time, replicate means and standard \
deviations, and the difference between increasing- and decreasing-wavenumber \
scans. These quantities define the frozen correction expected to be embodied \
in the subsequently supplied QCL wavenumber axes and distinguish calibration \
bias from repeatability, hysteresis, and warm-up drift; the notebook does not \
automatically transform those later axes. The default model is linear, while \
a quadratic term is retained only when residual structure and coefficient \
uncertainty support the additional degree of freedom. The comparison bound is \
the MIRcat absolute-wavenumber-accuracy specification,",
 StyleBox["1",
  FontVariations -> {"Superscript" -> True}],
 " but it remains metadata rather than an implemented pass/fail gate."
}], "Text",
 CellChangeTimes->{
  3.995988494863905*^9},ExpressionUUID->"0188c5f6-95fb-2645-b302-\
af88727a9040"],

Cell[BoxData[
 RowBox[{"nuReference", " ", "==", " ", "a0", " ", "+", " ", "a1", "*", 
  "nuQCL", " ", "+", " ", "a2", "*", "nuQCL", "^", "2"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"bf9d0ac3-6cf5-a046-9a93-46831652822e"],

Cell[BoxData[
 RowBox[{"RMSD", " ", "==", " ", "Sqrt", "[", 
  RowBox[{"Mean", "[", 
   RowBox[{"(", 
    RowBox[{"nuCorrected", " ", "-", " ", "nuReference"}], ")", "^", "2"}], 
   "]"}], "]"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"0a420cfd-d465-6d41-a9c9-c2aa621b52b4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"calibrationParameters", " ", "=", " ", 
   RowBox[{"<|", "\n", 
    RowBox[{
     RowBox[{"\"\<PolynomialOrder\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "1", ",", " ", "\"\<dimensionless\>\"", ",", 
        " ", "\"\<Use 1 for linear or 2 for quadratic calibration\>\"", ",", 
        " ", "\"\<Reader selection\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<WarmupTime_s\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<s\>\"", ",", 
        " ", "\"\<Elapsed warm-up time at first calibration scan\>\"", ",", 
        " ", "\"\<Reader input\>\""}], "]"}]}], ",", "\n", 
     RowBox[{"\"\<AcceptanceBound_cm1\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "0.5", ",", " ", "\"\<cm^-1\>\"", ",", 
        " ", "\"\<MIRcat absolute wavenumber accuracy specification used for \
comparison\>\"", ",", " ", "\"\<MIRcat documentation\>\""}], "]"}]}], ",", 
     "\n", 
     RowBox[{"\"\<PeakWindowHalfWidth_cm1\>\"", " ", "->", " ", 
      RowBox[{"parameter", "[", 
       RowBox[{
       "valueRequired", ",", " ", "\"\<cm^-1\>\"", ",", 
        " ", "\"\<Half-width used for each Gaussian peak fit\>\"", ",", 
        " ", "\"\<Reader input\>\""}], "]"}]}]}], "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{"parameterTable", "[", "calibrationParameters", "]"}]}], "Input",
 CellChangeTimes->{3.9959884950193424`*^9},
 CellLabel->"In[35]:=",ExpressionUUID->"db3e3f53-fe69-9142-857c-aa72195e9a7b"],

