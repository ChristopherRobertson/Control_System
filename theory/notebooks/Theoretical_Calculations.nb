              RowBox[{
              "lockinParameters", ",", " ", "\"\<SettlingTarget\>\""}], 
              "]"}]}], "]"}]}], ",", "\n", 
          RowBox[{"\"\<NoiseEquivalentBandwidth_Hz\>\"", " ", "->", " ", 
           RowBox[{"noiseEquivalentBandwidthHz", "[", 
            RowBox[{"tau", ",", " ", "order"}], "]"}]}], ",", "\n", 
          RowBox[{"\"\<ThreeDecibelBandwidth_Hz\>\"", " ", "->", " ", 
           RowBox[{"cutoffBandwidthHz", "[", 
            RowBox[{"tau", ",", " ", "order"}], "]"}]}]}], "\n", "|>"}]}]}], 
      "\n", "]"}]}], "\n", "]"}]}], 
  ";"}], "\n", "lockinSettlingSummary"}], "Input",
 CellChangeTimes->{3.9959884952228813`*^9},
