Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mylarRun", " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ftir", ",", " ", "qcl", ",", " ", "predicted", ",", " ", "centers", ",",
        " ", "halfWindow", ",", " ", "ftirFits", ",", " ", "qclFits"}], "}"}],
      ",", "\n", 
     RowBox[{
      RowBox[{"ftir", " ", "=", " ", 
       RowBox[{"importSpectrumCSV", "[", 
        RowBox[{"pv", "[", 
         RowBox[{"dataFiles", ",", " ", "\"\<Mylar_FTIR\>\""}], "]"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"qcl", " ", "=", " ", 
       RowBox[{"importSpectrumCSV", "[", 
        RowBox[{"pv", "[", 
         RowBox[{"dataFiles", ",", " ", "\"\<Mylar_QCL\>\""}], "]"}], "]"}]}],
       ";", "\n", 
      RowBox[{"predicted", " ", "=", " ", 
       RowBox[{"predictQCLFromFTIR", "[", 
        RowBox[{"ftir", ",", " ", 
         RowBox[{"qcl", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
         RowBox[{"pv", "[", 
          RowBox[{
          "spectralModelParameters", ",", 
           " ", "\"\<QCL_LinewidthFWHM_cm1\>\""}], "]"}]}], "]"}]}], ";", 
      "\n", 
      RowBox[{"centers", " ", "=", " ", 
       RowBox[{"pv", "[", 
        RowBox[{
        "mylarParameters", ",", " ", "\"\<ReferencePeakCenters_cm1\>\""}], 
        "]"}]}], ";", "\n", 
      RowBox[{"halfWindow", " ", "=", " ", 
       RowBox[{"pv", "[", 
        RowBox[{
        "calibrationParameters", ",", 
         " ", "\"\<PeakWindowHalfWidth_cm1\>\""}], "]"}]}], ";", "\n", 
      RowBox[{"ftirFits", " ", "=", " ", 
       RowBox[{"fitPeakList", "[", 
        RowBox[{
        "ftir", ",", " ", "centers", ",", " ", "halfWindow", ",", " ", "1"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"qclFits", " ", "=", " ", 
       RowBox[{"fitPeakList", "[", 
        RowBox[{
        "qcl", ",", " ", "centers", ",", " ", "halfWindow", ",", " ", "1"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<PredictedSpectrum\>\"", " ", "->", " ", "predicted"}], ",",
         "\n", 
        RowBox[{"\"\<ResidualSpectrum\>\"", " ", "->", " ", 
         RowBox[{"spectralResiduals", "[", 
          RowBox[{"predicted", ",", " ", "qcl"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<Metrics\>\"", " ", "->", " ", 
         RowBox[{"spectralMetrics", "[", 
          RowBox[{"predicted", ",", " ", "qcl"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<PeakComparison\>\"", " ", "->", " ", 
         RowBox[{"peakComparison", "[", 
          RowBox[{"ftirFits", ",", " ", "qclFits"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<OverlayPlot\>\"", " ", "->", " ", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ftir", ",", " ", "qcl", ",", " ", "predicted"}], "}"}], ",",
            " ", 
           RowBox[{"PlotLegends", " ", "->", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<FTIR\>\"", ",", " ", "\"\<QCL measured\>\"", ",", 
              " ", "\"\<QCL predicted\>\""}], "}"}]}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
           RowBox[{"FrameLabel", " ", "->", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Wavenumber (cm^-1)\>\"", ",", 
              " ", "\"\<Absorbance\>\""}], "}"}]}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]}]}], "\n", 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"If", "[", "\n", 
  RowBox[{
   RowBox[{"readyQ", "[", 
    RowBox[{
     RowBox[{"pv", "[", 
      RowBox[{"dataFiles", ",", " ", "\"\<Mylar_FTIR\>\""}], "]"}], ",", " ", 
     RowBox[{"pv", "[", 
      RowBox[{"dataFiles", ",", " ", "\"\<Mylar_QCL\>\""}], "]"}], ",", " ", 
     RowBox[{"pv", "[", 
      RowBox[{
      "spectralModelParameters", ",", " ", "\"\<QCL_LinewidthFWHM_cm1\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"pv", "[", 
      RowBox[{
      "mylarParameters", ",", " ", "\"\<ReferencePeakCenters_cm1\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"pv", "[", 
      RowBox[{
      "calibrationParameters", ",", " ", "\"\<PeakWindowHalfWidth_cm1\>\""}], 
      "]"}]}], "]"}], ",", "\n", "mylarRun", ",", "\n", 
   RowBox[{"displayValue", "[", "valueRequired", "]"}]}], "\n", 
  "]"}]}], "Input",
