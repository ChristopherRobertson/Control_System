None if absent\>\"", ",", " ", "\"\<Reader input\>\""}], "]"}]}]}], "\n", 
    "|>"}]}], ";"}], "\n", 
 RowBox[{"parameterTable", "[", "spectralModelParameters", "]"}]}], "Input",
