      ";", "\n", 
      RowBox[{"predicted", " ", "=", " ", 
       RowBox[{"predictQCLFromFTIR", "[", 
        RowBox[{"ftir", ",", " ", 
         RowBox[{"qcl", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
         RowBox[{"pv", "[", 
          RowBox[{
          "spectralModelParameters", ",", 
           " ", "\"\<QCL_LinewidthFWHM_cm1\>\""}], "]"}]}], "]"}]}], ";", 
      "\n", 
      RowBox[{"populationFit", " ", "=", " ", 
       RowBox[{"mbPopulationFit", "[", 
        RowBox[{"ftir", ",", " ", 
         RowBox[{"pv", "[", 
          RowBox[{
          "calibrationParameters", ",", 
           " ", "\"\<PeakWindowHalfWidth_cm1\>\""}], "]"}]}], "]"}]}], ";", 
      "\n", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<PredictedSpectrum\>\"", " ", "->", " ", "predicted"}], ",",
         "\n", 
        RowBox[{"\"\<ResidualSpectrum\>\"", " ", "->", " ", 
         RowBox[{"spectralResiduals", "[", 
          RowBox[{"predicted", ",", " ", "qcl"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<Metrics\>\"", " ", "->", " ", 
         RowBox[{"spectralMetrics", "[", 
          RowBox[{"predicted", ",", " ", "qcl"}], "]"}]}], ",", "\n", 
        RowBox[{"\"\<ConformerPopulationFit\>\"", " ", "->", " ", 
         "populationFit"}], ",", "\n", 
        RowBox[{"\"\<OverlayPlot\>\"", " ", "->", " ", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ftir", ",", " ", "qcl", ",", " ", "predicted"}], "}"}], ",",
            " ", 
           RowBox[{"PlotLegends", " ", "->", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<FTIR\>\"", ",", " ", "\"\<QCL measured\>\"", ",", 
              " ", "\"\<QCL predicted\>\""}], "}"}]}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
           RowBox[{"FrameLabel", " ", "->", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Wavenumber (cm^-1)\>\"", ",", 
              " ", "\"\<Absorbance\>\""}], "}"}]}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]}]}], "\n", 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"If", "[", "\n", 
  RowBox[{
   RowBox[{"readyQ", "[", 
    RowBox[{
     RowBox[{"pv", "[", 
      RowBox[{"dataFiles", ",", " ", "\"\<MbCO_FTIR\>\""}], "]"}], ",", " ", 
