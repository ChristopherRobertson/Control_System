  "probe", "[", "t", "]", " ", "*", "*", " ", "jitter", "[", "t", "]", " ", "*",
   "*", " ", "detector", "[", "t", "]", " ", "*", "*", " ", "lockin", "[", 
  "t", "]"}]], "DisplayFormula",
 TextAlignment->Center,ExpressionUUID->"35a643a4-9666-ed45-95ee-c5255a367a43"],

