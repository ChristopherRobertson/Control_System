Notebook[{

Cell[CellGroupData[{
Cell["RSI Supplemental Theoretical Calculations", "Title",ExpressionUUID->"db662b31-fcf3-e442-9578-81db2b69e8ff"],

Cell["\<\
Forward modeling, calibration, instrument response, and pump\[Dash]probe \
validation\
\>", "Subtitle",ExpressionUUID->"b9c63aff-edf6-9947-9eee-ef0a20f586ca"],

Cell["\<\
This notebook presents the theoretical and numerical framework used to \
predict measurements obtained with the tunable QCL pump\[Dash]probe \
mid-infrared platform from independently determined instrument, sample, \
acquisition, and kinetic inputs. The calculations encompass spectral forward \
modeling, calibration, spectral and temporal instrument response, noise and \
uncertainty propagation, and validation with polystyrene, Mylar, \
HRP\[Dash]CO, and Mb\[Dash]CO. Entries displayed as [VALUE REQUIRED] identify \
quantities and file paths that have already been determined by the methods \
reported separately but await transcription into the calculation; they are \
not estimated within the notebook. The resulting tables, residual analyses, \
and figures provide quantitative comparisons between independently specified \
predictions and the corresponding measurements.\
\>", "Text",ExpressionUUID->"13a3137b-20d7-5642-b838-8e2d7b00149e"],

Cell["\<\
All measured inputs are supplied as preprocessed comma-separated-value (CSV) \
files with predefined numeric column structures. This single-format data \
boundary preserves explicit units and column identities across spectra, \
calibration measurements, pump\[Dash]probe transients, detector traces, and \
baseline records. Column identities are not inferred, and arbitrary \
source-file conversion is not performed within the notebook; any processing \
completed before import is documented with the corresponding dataset. This \
separation keeps data preparation distinct from the theoretical calculations \
and supports reproducible evaluation of the forward model.\
\>", "Text",ExpressionUUID->"c68d75a1-392a-8049-805d-656437e45947"],

Cell[CellGroupData[{

Cell["1. Notebook Conventions and Physical Constants", "Section",ExpressionUUID->"b18f5411-c373-f24d-9dc6-611aa127c798"],

Cell["\<\
This section establishes the parameter representation, exact physical \
constants, and numerical safeguards used throughout the notebook. No \
additional experimental input is introduced here; the independently \
determined quantities used by later sections remain represented by \
Missing[\"ValueRequired\"] until their values are transcribed. Helper \
functions construct parameter tables containing each value, unit, meaning, \
and source, retrieve values for calculations, and suppress evaluation \
whenever a required dependency remains incomplete. The Planck constant, speed \
of light in vacuum, Avogadro constant, elementary charge, and Boltzmann \
constant are fixed at their exact SI values. These conventions maintain unit \
and provenance visibility and prevent placeholder text from entering \
numerical expressions, while Missing[\"NotCalculated\"] distinguishes an \
incomplete calculation from a physically meaningful zero or negative result.\
\>", "Text",ExpressionUUID->"2ad62555-eb28-d341-b3d0-7dbb7a4a4c93"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"valueRequired", " ", "=", " ", 
   RowBox[{"Missing", "[", "\"\<ValueRequired\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"displayValue", "[", 
    RowBox[{"Missing", "[", "\"\<ValueRequired\>\"", "]"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Style", "[", 
    RowBox[{"\"\<[VALUE REQUIRED]\>\"", ",", " ", "Red", ",", " ", "Bold"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"displayValue", "[", "x_", "]"}], " ", ":=", " ", "x"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"parameter", "[", 
    RowBox[{
    "value_", ",", " ", "unit_", ",", " ", "description_", ",", " ", 
     "source_"}], "]"}], " ", ":=", " ", 
   RowBox[{"<|", "\n", 
    RowBox[{
     RowBox[{"\"\<Value\>\"", " ", "->", " ", "value"}], ",", "\n", 
     RowBox[{"\"\<Unit\>\"", " ", "->", " ", "unit"}], ",", "\n", 
     RowBox[{"\"\<Description\>\"", " ", "->", " ", "description"}], ",", 
     "\n", 
     RowBox[{"\"\<Source\>\"", " ", "->", " ", "source"}]}], "\n", "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"parameterTable", "[", "a_Association", "]"}], " ", ":=", " ", 
   RowBox[{"Grid", "[", "\n", 
    RowBox[{
     RowBox[{"Prepend", "[", "\n", 
      RowBox[{
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", " ", 
            RowBox[{"displayValue", "[", 
             RowBox[{"#2", "[", "\"\<Value\>\"", "]"}], "]"}], ",", " ", 
            RowBox[{"#2", "[", "\"\<Unit\>\"", "]"}], ",", " ", 
            RowBox[{"#2", "[", "\"\<Description\>\"", "]"}], ",", " ", 
            RowBox[{"#2", "[", "\"\<Source\>\"", "]"}]}], "}"}], " ", "&"}], ",",
          " ", "a"}], "]"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"\"\<Key\>\"", ",", " ", "\"\<Value\>\"", ",", 
         " ", "\"\<Units\>\"", ",", " ", "\"\<Description\>\"", ",", 
         " ", "\"\<Source\>\""}], "}"}]}], "\n", "]"}], ",", "\n", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", "\n", 
     RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", "\n", 
     RowBox[{"Background", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Lighter", "[", 
           RowBox[{"Gray", ",", " ", "0.90"}], "]"}], ",", " ", "None"}], 
         "}"}]}], "}"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pv", "[", 
    RowBox[{"a_Association", ",", " ", "key_String"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"a", "[", "key", "]"}], "[", "\"\<Value\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"readyQ", "[", "values___", "]"}], " ", ":=", " ", 
   RowBox[{"FreeQ", "[", 
    RowBox[{
     RowBox[{"{", "values", "}"}], ",", " ", "_Missing"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"requireValues", "[", 
    RowBox[{"label_String", ",", " ", "values_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", "\n", 
    RowBox[{
     RowBox[{"FreeQ", "[", 
      RowBox[{"values", ",", " ", "_Missing"}], "]"}], ",", "\n", "True", ",",
      "\n", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{
         "label", " ", "<>", 
          " ", "\"\<: one or more inputs remain [VALUE REQUIRED].\>\""}], ",",
          " ", "Red", ",", " ", "Bold"}], "]"}], "]"}], ";", "\n", 
      "False"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"safeEvaluate", ",", " ", "HoldAll"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"safeEvaluate", "[", 
    RowBox[{
    "label_String", ",", " ", "values_List", ",", " ", "expression_"}], "]"}],
    " ", ":=", " ", 
   RowBox[{"If", "[", "\n", 
    RowBox[{
     RowBox[{"requireValues", "[", 
      RowBox[{"label", ",", " ", "values"}], "]"}], ",", " ", "expression", ",",
      " ", 
     RowBox[{"Missing", "[", "\"\<NotCalculated\>\"", "]"}]}], "\n", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{3.9959884949774723`*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"a7dc9f8b-9756-2141-8a70-f1fd6a2360f2"],

