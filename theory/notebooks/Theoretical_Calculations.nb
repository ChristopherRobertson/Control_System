Henry et al. 1983\>\"", ",", 
         " ", "\"\<Fit initialization only; do not report as measured\>\""}], 
        "}"}]}], "\n", "}"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
     RowBox[{"Background", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Lighter", "[", 
           RowBox[{"Gray", ",", " ", "0.90"}], "]"}], ",", " ", "None"}], 
         "}"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", "mbLiteratureGuide"}], "Input",
 CellChangeTimes->{3.995988495195101*^9},
