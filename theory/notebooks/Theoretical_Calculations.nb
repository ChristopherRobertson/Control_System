Cell[BoxData[{
 RowBox[{
  RowBox[{"mbInitialPhotolysis", " ", "=", " ", 
   RowBox[{"safeEvaluate", "[", "\n", 
    RowBox[{"\"\<Mb initial photolysis\>\"", ",", "\n", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"pv", "[", 
        RowBox[{"mbParameters", ",", " ", "\"\<PumpPulseEnergy_J\>\""}], 
        "]"}], ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"mbParameters", ",", " ", "\"\<PumpWavelength_nm\>\""}], 
        "]"}], ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"mbParameters", ",", " ", "\"\<PumpAbsorbance\>\""}], "]"}], ",",
        " ", 
       RowBox[{"pv", "[", 
        RowBox[{
        "mbParameters", ",", " ", "\"\<PumpProbeOverlapFraction\>\""}], "]"}],
        ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"mbParameters", ",", " ", "\"\<PhotolysisQuantumYield\>\""}], 
        "]"}], ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"mbParameters", ",", " ", "\"\<ProteinConcentration_M\>\""}], 
        "]"}], ",", " ", 
       RowBox[{"pv", "[", 
        RowBox[{"mbParameters", ",", " ", "\"\<OverlapArea_m2\>\""}], "]"}], ",",
        " ", 
       RowBox[{"pv", "[", 
        RowBox[{"mbParameters", ",", " ", "\"\<PathLength_cm\>\""}], "]"}]}], 
      "}"}], ",", "\n", 
     RowBox[{"<|", "\n", 
      RowBox[{
       RowBox[{"\"\<IncidentPhotons_inOverlap\>\"", " ", "->", " ", 
        RowBox[{"incidentPhotons", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"pv", "[", 
            RowBox[{"mbParameters", ",", " ", "\"\<PumpPulseEnergy_J\>\""}], 
            "]"}], "*", 
           RowBox[{"pv", "[", 
            RowBox[{
            "mbParameters", ",", " ", "\"\<PumpProbeOverlapFraction\>\""}], 
            "]"}]}], ",", " ", 
          RowBox[{"pv", "[", 
           RowBox[{"mbParameters", ",", " ", "\"\<PumpWavelength_nm\>\""}], 
           "]"}]}], "]"}]}], ",", "\n", 
       RowBox[{"\"\<AbsorbedPhotons_inOverlap\>\"", " ", "->", " ", 
        RowBox[{"absorbedPhotons", "[", 
         RowBox[{
          RowBox[{"pv", "[", 
           RowBox[{"mbParameters", ",", " ", "\"\<PumpPulseEnergy_J\>\""}], 
           "]"}], ",", " ", 
          RowBox[{"pv", "[", 
           RowBox[{"mbParameters", ",", " ", "\"\<PumpWavelength_nm\>\""}], 
           "]"}], ",", " ", 
          RowBox[{"pv", "[", 
           RowBox[{"mbParameters", ",", " ", "\"\<PumpAbsorbance\>\""}], 
           "]"}], ",", " ", 
          RowBox[{"pv", "[", 
           RowBox[{
           "mbParameters", ",", " ", "\"\<PumpProbeOverlapFraction\>\""}], 
           "]"}]}], "]"}]}], ",", "\n", 
       RowBox[{"\"\<Molecules_inOverlap\>\"", " ", "->", " ", 
