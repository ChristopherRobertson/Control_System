.idea/

# Archived legacy artifacts kept outside active app path
archive/

# Generated operational hardware artifacts
runs/
logs/

# Campaign metadata and analyzed results are versionable. Canonical outputs
# remain local until explicit promotion, and large raw acquisitions remain
# local for campaign archival rather than Git history.
calibration/timing_calibration.csv
calibration/timing_offsets.yaml
calibration/**/raw_pico_traces/**
calibration/**/raw_hf2li/**
calibration/**/raw_mircat/**
calibration/**/readbacks/**/raw/**
!calibration/**/raw_pico_traces/.gitkeep
!calibration/**/raw_hf2li/.gitkeep
!calibration/**/raw_mircat/.gitkeep
!calibration/**/readbacks/**/raw/.gitkeep

