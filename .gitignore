# Local Python environments and caches
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Local/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Archived legacy artifacts kept outside active app path
archive/

# Generated operational hardware artifacts
evidence/experiments/runs/
evidence/experiments/logs/

# Campaign metadata and analyzed results are versionable. Canonical outputs
# remain local until explicit promotion, and large raw acquisitions remain
# local for campaign archival rather than Git history.
evidence/calibration/**/timing_calibration.csv
evidence/calibration/**/timing_offsets.yaml
evidence/calibration/**/shared/staging/raw_pico_traces/**
evidence/calibration/**/shared/staging/raw_hf2li/**
evidence/calibration/**/shared/staging/raw_mircat/**
evidence/calibration/**/phases/**/raw/**
!evidence/calibration/**/shared/staging/raw_pico_traces/.gitkeep
!evidence/calibration/**/shared/staging/raw_hf2li/.gitkeep
!evidence/calibration/**/shared/staging/raw_mircat/.gitkeep
!evidence/calibration/**/phases/**/raw/.gitkeep
